{%- comment -%}
  Sofia Lark filter bar, above the product grid of the categories, the jewellery collections and
  the search results. It uses the filters the shop already has in Shopify (Search & Discovery app:
  price, material, design, colour, earring closure …), so nothing is set up here: whatever filters
  admin has, the bar shows, in Latvian. Each filter opens a small panel of choices with how many
  pieces each has (a sheet from the bottom on phones); a choice reloads the page at once. Under the
  bar: how many pieces are shown, the choices in force (each one removes itself) and "Notīrīt visu".
  Without script it is a plain form with a "Rādīt" button.

  - source: the 'collection' or 'search' object
  - menu: optional menu whose parent link `menu_parent` lists the categories, shown as chips above
  - menu_parent: title of that parent link, e.g. "Rotas"
{%- endcomment -%}
{{ 'sl-filters.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sl-filters.js' | asset_url }}" defer="defer"></script>

{%- liquid
  if source.results
    assign is_search = true
    assign count = source.results_count
    assign action = routes.search_url
    assign clear_url = source.terms | url_encode | prepend: '?type=product&q=' | prepend: routes.search_url
  else
    assign is_search = false
    assign count = source.products_count
    assign action = source.url
    assign clear_url = source.url
  endif

  assign active_count = 0
  for filter in source.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  assign sort_by = source.sort_by | default: source.default_sort_by

  assign last = count | modulo: 10
  assign last_two = count | modulo: 100
  if last == 1 and last_two != 11
    assign noun = 'rota'
  else
    assign noun = 'rotas'
  endif

  assign cats = nil
  if menu != blank
    for link in menu.links
      if link.title == menu_parent
        assign cats = link
        break
      endif
    endfor
  endif
-%}

<div class="sl-fl" id="SlFilters" data-sl-filters>
  <div class="page-width">
    {%- if cats and cats.links.size > 0 -%}
      <nav class="sl-fl__cats" aria-label="{{ menu_parent | escape }}">
        <ul class="sl-fl__cat-list" role="list">
          {%- comment -%} "Visas rotas" first, then the categories in menu order {%- endcomment -%}
          {%- for link in cats.links -%}
            {%- if link.url == cats.url -%}
              {%- assign here = false -%}
              {%- if link.url == source.url or link.object.handle == source.handle -%}{%- assign here = true -%}{%- endif -%}
              <li><a class="sl-fl__cat" href="{{ link.url }}"{% if here %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
          {%- for link in cats.links -%}
            {%- if link.url != cats.url -%}
              {%- assign here = false -%}
              {%- if link.url == source.url or link.object.handle == source.handle -%}{%- assign here = true -%}{%- endif -%}
              <li><a class="sl-fl__cat" href="{{ link.url }}"{% if here %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <form class="sl-fl__form" action="{{ action }}#SlFilters" method="get" data-sl-filters-form>
      {%- if is_search -%}
        <input type="hidden" name="q" value="{{ source.terms | escape }}">
        <input type="hidden" name="type" value="product">
      {%- endif -%}

      <div class="sl-fl__bar">
        <div class="sl-fl__groups">
          {%- for filter in source.filters -%}
            {%- liquid
              if filter.param_name contains 'filter.v.option.'
                continue
              endif

              assign usable = 0
              for value in filter.values
                if value.count > 0 or value.active
                  assign usable = usable | plus: 1
                endif
              endfor
              if filter.type == 'price_range'
                if filter.range_max == 0
                  continue
                endif
              elsif usable < 2 and filter.active_values.size == 0
                continue
              endif

              case filter.param_name
                when 'filter.v.price'
                  assign label = 'Cena'
                when 'filter.v.availability'
                  assign label = 'Pieejamība'
                when 'filter.p.m.custom.material'
                  assign label = 'Materiāls'
                when 'filter.p.m.custom.design'
                  assign label = 'Stils'
                when 'filter.p.m.custom.color'
                  assign label = 'Krāsa'
                when 'filter.p.product_type'
                  assign label = 'Veids'
                when 'filter.p.vendor'
                  assign label = 'Zīmols'
                when 'filter.p.tag'
                  assign label = 'Birkas'
                else
                  assign label = filter.label
              endcase
              if filter.param_name contains 'closure'
                assign label = 'Aizdare'
              endif

              assign group_id = 'SlFl-' | append: forloop.index
              assign picked = filter.active_values.size
              if filter.type == 'price_range'
                assign picked = 0
                if filter.min_value.value != nil or filter.max_value.value != nil
                  assign picked = 1
                endif
              endif
            -%}
            <details class="sl-fl__group" data-sl-filter>
              <summary class="sl-fl__toggle{% if picked > 0 %} is-active{% endif %}" aria-controls="{{ group_id }}">
                <span>{{ label | escape }}</span>
                {%- if picked > 0 and filter.type != 'price_range' -%}
                  <span class="visually-hidden">, izvēlētas:</span><span class="sl-fl__picked">{{ picked }}</span>
                {%- endif -%}
                <svg class="sl-fl__chev" aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="14" height="14"><path d="M4.5 7.5 10 13l5.5-5.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              </summary>

              <div class="sl-fl__panel" id="{{ group_id }}">
                <div class="sl-fl__panel-head">
                  <span class="sl-fl__panel-title">{{ label | escape }}</span>
                  <button type="button" class="sl-fl__close" data-sl-filter-close aria-label="Aizvērt">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                  </button>
                </div>

                {%- if filter.type == 'price_range' -%}
                  {%- liquid
                    assign top = filter.range_max | plus: 99 | divided_by: 100
                    assign from = ''
                    assign to = ''
                    if filter.min_value.value != nil
                      assign from = filter.min_value.value | divided_by: 100
                    endif
                    if filter.max_value.value != nil
                      assign to = filter.max_value.value | divided_by: 100
                    endif
                  -%}
                  <fieldset class="sl-fl__price">
                    <legend class="visually-hidden">{{ label | escape }}, €</legend>
                    <label class="sl-fl__field">
                      <span>No, €</span>
                      <input type="number" inputmode="numeric" min="0" max="{{ top }}" step="1" name="{{ filter.min_value.param_name }}" value="{{ from }}" placeholder="0">
                    </label>
                    <span class="sl-fl__dash" aria-hidden="true">–</span>
                    <label class="sl-fl__field">
                      <span>Līdz, €</span>
                      <input type="number" inputmode="numeric" min="0" max="{{ top }}" step="1" name="{{ filter.max_value.param_name }}" value="{{ to }}" placeholder="{{ top }}">
                    </label>
                  </fieldset>
                  <button type="submit" class="sl-fl__apply">Rādīt</button>
                {%- else -%}
                  <fieldset class="sl-fl__options">
                    <legend class="visually-hidden">{{ label | escape }}</legend>
                    <ul role="list">
                      {%- for value in filter.values -%}
                        {%- liquid
                          if value.count == 0 and value.active == false
                            continue
                          endif
                          assign value_label = value.label | replace: '  ', ' ' | strip
                          if filter.param_name == 'filter.v.availability'
                            if value.value == '1'
                              assign value_label = 'Ir pieejamas'
                            else
                              assign value_label = 'Izpārdotas'
                            endif
                          endif
                        -%}
                        <li>
                          <label class="sl-fl__opt">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}>
                            <span class="sl-fl__box" aria-hidden="true"></span>
                            <span class="sl-fl__opt-label">{{ value_label | escape }}</span>
                            <span class="sl-fl__opt-count">{{ value.count }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </fieldset>
                  <noscript><button type="submit" class="sl-fl__apply">Rādīt</button></noscript>
                {%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>

        {%- if source.sort_options.size > 0 -%}
          <div class="sl-fl__sort">
            <label class="sl-fl__sort-label" for="SlFlSort">Kārtot</label>
            <select id="SlFlSort" class="sl-fl__select" name="sort_by">
              {%- for option in source.sort_options -%}
                {%- liquid
                  # "most relevant" only means something for a typed search
                  if option.value == 'most-relevant'
                    continue
                  endif
                  case option.value
                    when 'manual'
                      assign option_label = 'Ieteicamās'
                    when 'relevance'
                      assign option_label = 'Atbilstošākās'
                    when 'best-selling'
                      assign option_label = 'Populārākās'
                    when 'title-ascending'
                      assign option_label = 'A–Z'
                    when 'title-descending'
                      assign option_label = 'Z–A'
                    when 'price-ascending'
                      assign option_label = 'Lētākās vispirms'
                    when 'price-descending'
                      assign option_label = 'Dārgākās vispirms'
                    when 'created-descending'
                      assign option_label = 'Jaunākās'
                    when 'created-ascending'
                      assign option_label = 'Vecākās'
                    else
                      assign option_label = option.name
                  endcase
                -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option_label }}</option>
              {%- endfor -%}
            </select>
            <svg class="sl-fl__chev" aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="14" height="14"><path d="M4.5 7.5 10 13l5.5-5.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          </div>
        {%- endif -%}
      </div>
      <noscript><button type="submit" class="sl-fl__apply sl-fl__apply--bar">Rādīt</button></noscript>
    </form>

    <div class="sl-fl__status">
      <p class="sl-fl__count" role="status">{{ count }} {{ noun }}</p>
      {%- if active_count > 0 -%}
        <ul class="sl-fl__chips" role="list" aria-label="Izvēlētie filtri">
          {%- for filter in source.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                {%- liquid
                  if filter.min_value.value != nil and filter.max_value.value != nil
                    assign from = filter.min_value.value | divided_by: 100
                    assign to = filter.max_value.value | divided_by: 100
                    assign price_label = '€' | append: from | append: '–' | append: to
                  elsif filter.min_value.value != nil
                    assign from = filter.min_value.value | divided_by: 100
                    assign price_label = 'No €' | append: from
                  else
                    assign to = filter.max_value.value | divided_by: 100
                    assign price_label = 'Līdz €' | append: to
                  endif
                -%}
                <li>
                  <a class="sl-fl__chip" href="{{ filter.url_to_remove }}#SlFilters" aria-label="Noņemt filtru: cena {{ price_label }}">
                    {{ price_label }}
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="12" height="12"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                  </a>
                </li>
              {%- endif -%}
            {%- else -%}
              {%- for value in filter.active_values -%}
                {%- liquid
                  assign value_label = value.label | replace: '  ', ' ' | strip
                  if filter.param_name == 'filter.v.availability'
                    if value.value == '1'
                      assign value_label = 'Ir pieejamas'
                    else
                      assign value_label = 'Izpārdotas'
                    endif
                  endif
                -%}
                <li>
                  <a class="sl-fl__chip" href="{{ value.url_to_remove }}#SlFilters" aria-label="Noņemt filtru: {{ value_label | escape }}">
                    {{ value_label | escape }}
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="12" height="12"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          <li><a class="sl-fl__clear" href="{{ clear_url }}#SlFilters">Notīrīt visu</a></li>
        </ul>
      {%- endif -%}
    </div>

    {%- if count == 0 and active_count > 0 -%}
      <div class="sl-fl__empty">
        <p>Ar šīm izvēlēm neatradām nevienu rotu.</p>
        <a class="sl-fl__clear" href="{{ clear_url }}#SlFilters">Notīrīt filtrus</a>
      </div>
    {%- endif -%}
  </div>
</div>
