{%- comment -%}
  Sofia Lark packaging: how every order arrives, as a large photograph with a smaller detail
  beside it, and a few words. A video uploaded to Shopify can take the large photograph's place;
  it plays silently in a loop while on screen, has a pause button, and with reduced motion waits
  for a press. (YouTube is left out on purpose: its player always shows some of its own buttons.)
{%- endcomment -%}
{%- liquid
  assign sid = 'SlFilm-' | append: section.id
  assign video = section.settings.video
  assign image = section.settings.image
  assign detail = section.settings.image_detail
-%}
{{ 'sl-product.css' | asset_url | stylesheet_tag }}

{%- if video != blank or image != blank -%}
<section class="sl-film{% if detail != blank %} sl-film--pair{% endif %}" aria-labelledby="{{ sid }}-title"{% if video != blank %} data-sl-film{% endif %}>
  <div class="page-width sl-film__inner">
    <div class="sl-film__media">
      <div class="sl-film__frame" data-sl-rise>
        {%- if video != blank -%}
          <div class="sl-film__player" data-sl-film-player>
            {{- video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', class: 'sl-film__video', image_size: '1400x' -}}
          </div>
          <button type="button" class="sl-film__toggle" data-sl-film-toggle aria-label="Atskaņot video" hidden>
            <span class="sl-film__icon" aria-hidden="true"></span>
          </button>
        {%- else -%}
          {%- assign image_alt = image.alt | default: section.settings.heading | escape -%}
          {{- image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 48vw, 100vw', loading: 'lazy', alt: image_alt, class: 'sl-film__img' -}}
        {%- endif -%}
      </div>
      {%- if detail != blank -%}
        <div class="sl-film__detail" data-sl-rise style="--d: 120ms">
          {%- assign detail_alt = detail.alt | escape -%}
          {{- detail | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 20vw, 44vw', loading: 'lazy', alt: detail_alt, class: 'sl-film__img' -}}
        </div>
      {%- endif -%}
    </div>

    <div class="sl-film__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-film__eyebrow" data-sl-rise>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="{{ sid }}-title" class="sl-film__title" data-sl-rise style="--d: 60ms">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="sl-film__body" data-sl-rise style="--d: 120ms">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <figure class="sl-film__quote" data-sl-rise style="--d: 180ms">
          <blockquote><p>{{ section.settings.quote | escape }}</p></blockquote>
          {%- if section.settings.quote_name != blank -%}<figcaption>{{ section.settings.quote_name | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Sofia Lark packaging",
  "tag": "div",
  "class": "sl-film-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph"
    },
    {
      "type": "image_picker",
      "id": "image_detail",
      "label": "Detail photograph (optional)",
      "info": "A smaller picture beside the large one."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video uploaded to Shopify (optional)",
      "info": "Shown in place of the large photograph. Plays silently in a loop, with no player buttons but a small pause button."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Above the heading",
      "default": "Iepakojums"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Katra rota skaisti iepakota"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Katru pasūtījumu iesaiņojam skaistā, dabai draudzīgā iepakojumā.</p>"
    },
    {
      "type": "header",
      "content": "A customer's words"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Review",
      "info": "Only a real review, as it was written."
    },
    {
      "type": "text",
      "id": "quote_name",
      "label": "Name"
    }
  ],
  "presets": [
    {
      "name": "Sofia Lark packaging"
    }
  ]
}
{% endschema %}
