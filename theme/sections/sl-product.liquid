{%- comment -%}
  Sofia Lark product page: the photographs scroll on the left while the buy box stays put.
  The buy box answers, in order: what it is, what it costs, how big and what it is made of,
  which variant (as photographs when every variant has its own), what is left of it, and what
  happens after you buy (free delivery from the threshold, pickup in Rīga, returns, packaging).
  It works for every product as it is: the facts are read from the description by
  sl-product-facts (metafields win when they are filled), and every part that has nothing to
  show is left out. sl-product.js adds the variant picker, the cart and the phone bar; without
  it the form still adds the chosen variant to the cart.
{%- endcomment -%}
{{ 'sl-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sl-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sid = 'SlProduct-' | append: section.id
  assign form_id = 'SlProductForm-' | append: section.id
  assign current = product.selected_or_first_available_variant
  assign free_cents = section.settings.free_shipping | times: 100
  assign lead = current.featured_media | default: product.featured_media

  # ---------- facts: size, material and promises, from sl-product-facts ----------
  capture facts_raw
    render 'sl-product-facts', product: product
  endcapture
  assign fr = '§' | append: facts_raw
  assign f_keys = 'subtitle,size,length,width,diameter,material,plating,stone,color,closure,weight,features,handmade,care' | split: ','
  for k in f_keys
    assign needle = '§' | append: k | append: '¦'
    assign val = ''
    if fr contains needle
      assign parts = fr | split: needle
      assign val = parts[1] | split: '§' | first | strip
    endif
    case k
      when 'subtitle'
        assign f_subtitle = val
      when 'size'
        assign f_size = val
      when 'length'
        assign f_length = val
      when 'width'
        assign f_width = val
      when 'diameter'
        assign f_diameter = val
      when 'material'
        assign f_material = val
      when 'plating'
        assign f_plating = val
      when 'stone'
        assign f_stone = val
      when 'color'
        assign f_color = val
      when 'closure'
        assign f_closure = val
      when 'weight'
        assign f_weight = val
      when 'features'
        assign f_features = val
      when 'handmade'
        assign f_handmade = val
      when 'care'
        assign f_care = val
    endcase
  endfor
  assign f_water = false
  assign f_tarnish = false
  assign f_hypo = false
  assign f_greece = false
  if fr contains '§flag¦water§'
    assign f_water = true
  endif
  if fr contains '§flag¦tarnish§'
    assign f_tarnish = true
  endif
  if fr contains '§flag¦hypo§'
    assign f_hypo = true
  endif
  if fr contains '§flag¦greece§'
    assign f_greece = true
  endif

  # the size as one short phrase: "61 × 14 mm", "5 × 5 cm", "Garums 48 cm + 6 cm"
  assign dims = ''
  if f_length != '' and f_width != ''
    assign l_unit = f_length | slice: -2, 2
    assign w_unit = f_width | slice: -2, 2
    assign l_part = f_length
    if l_unit == w_unit
      assign l_part = f_length | remove_last: l_unit | strip
    endif
    assign dims = l_part | append: ' × ' | append: f_width
  elsif f_size != ''
    assign dims = f_size
  elsif f_length != ''
    assign dims = 'Garums ' | append: f_length
  elsif f_diameter != ''
    assign dims = 'Ø ' | append: f_diameter
  endif
  if dims != ''
    assign dims = dims | replace: ' X ', ' × ' | replace: ' x ', ' × ' | replace: 'X', ' × ' | replace: 'x', ' × ' | replace: 'cm', ' cm' | replace: 'mm', ' mm' | replace: '  ', ' ' | replace: '  ', ' ' | strip
  endif
  # a size with no number is a ring that adjusts ("regulējams", "Adjustable") or a note to
  # drop ("Lūdzu norādiet izmēru"); a bare number is a ring size ("18")
  if dims != ''
    assign dims_digit = false
    for dg in (0..9)
      assign dg_s = dg | append: ''
      if dims contains dg_s
        assign dims_digit = true
        break
      endif
    endfor
    assign dims_low = dims | downcase
    if dims_digit == false
      if dims_low contains 'regul' or dims_low contains 'adjust'
        assign dims = 'Regulējams izmērs'
      else
        assign dims = ''
      endif
    elsif dims.size <= 3
      assign dims = 'Izmērs ' | append: dims
    endif
  endif

  # the metal in a few words: the first clause, capitalised, at most 44 characters
  assign finish = f_material
  if finish != ''
    assign finish = finish | split: ';' | first | replace: ',', ', ' | replace: ' ,', ',' | replace: '  ', ' ' | replace: '  ', ' ' | strip | truncate: 44, '…'
    assign finish_end = finish | slice: -1
    if finish_end == '.'
      assign finish = finish | remove_last: '.' | strip
    endif
    assign first_letter = finish | slice: 0 | upcase
    assign rest = finish | slice: 1, 60
    assign finish = first_letter | append: rest
  endif

  assign has_specs = false
  if f_size != '' or f_length != '' or f_width != '' or f_diameter != '' or f_material != '' or f_plating != '' or f_stone != '' or f_color != '' or f_closure != '' or f_weight != '' or f_features != '' or f_water or f_tarnish or f_hypo or f_greece
    assign has_specs = true
  endif

  # ---------- gallery ----------
  # Media attached to a variant are shown through the photo tiles. A product with few photos of
  # its own fills the gallery with its variant photos instead, so it never looks empty.
  assign variant_media = ','
  if product.variants.size > 1
    for v in product.variants
      if v.featured_media
        assign variant_media = variant_media | append: v.featured_media.id | append: ','
      endif
    endfor
  endif
  assign own_count = 0
  assign var_count = 0
  for media in product.media
    if lead and media.id == lead.id
      continue
    endif
    assign key = ',' | append: media.id | append: ','
    if variant_media contains key
      assign var_count = var_count | plus: 1
    else
      assign own_count = own_count | plus: 1
    endif
  endfor
  assign base = 0
  if lead
    assign base = 1
  endif
  assign room = section.settings.max_media | minus: base
  assign own_shown = own_count
  if own_shown > room
    assign own_shown = room
  endif
  assign var_shown = 0
  assign so_far = base | plus: own_shown
  if so_far < 4
    assign var_shown = section.settings.max_media | minus: so_far
    if var_shown > var_count
      assign var_shown = var_count
    endif
  endif
  assign total = so_far | plus: var_shown

  # ---------- breadcrumb: the collection the visitor came from, or the product's own ----------
  assign crumb = collection
  if crumb == blank
    for c in product.collections
      if c.handle != 'all' and c.handle != 'frontpage'
        assign crumb = c
        break
      endif
    endfor
  endif

  assign gallery_sizes = '(min-width: 990px) 56vw, 88vw'
-%}

<section
  id="{{ sid }}"
  class="sl-p"
  data-sl-product
  data-section-id="{{ section.id }}"
  aria-label="{{ product.title | escape }}"
  style="--sl-p-zoom: {{ section.settings.swatch_zoom | divided_by: 100.0 }};"
>
  <div class="page-width">
    <nav class="sl-p__crumbs" aria-label="Atrašanās vieta">
      <a href="{{ routes.root_url }}">Sākums</a>
      {%- if crumb != blank -%}
        <span aria-hidden="true">/</span><a href="{{ crumb.url }}">{{ crumb.title | escape }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="sl-p__grid">
      {%- comment -%} ---------- photographs ---------- {%- endcomment -%}
      <div class="sl-p__gallery-wrap">
        <div class="sl-p__gallery" data-sl-gallery>
          {%- assign shown = 0 -%}
          {%- if lead -%}
            {%- assign shown = 1 -%}
            <figure class="sl-p__media sl-p__media--wide sl-p__media--lead" data-sl-lead>
              {%- assign lead_alt = lead.alt | default: product.title | escape -%}
              <button type="button" class="sl-p__zoom" data-sl-zoom aria-label="Palielināt attēlu">
              {{- lead.preview_image | image_url: width: 1600 | image_tag:
                widths: '600, 800, 1000, 1200, 1600',
                sizes: gallery_sizes,
                fetchpriority: 'high',
                loading: 'eager',
                alt: lead_alt,
                class: 'sl-p__img'
              -}}
              </button>
            </figure>
          {%- else -%}
            <figure class="sl-p__media sl-p__media--wide">
              {{- 'product-1' | placeholder_svg_tag: 'sl-p__img sl-p__img--placeholder' -}}
            </figure>
          {%- endif -%}

          {%- liquid
            assign own_done = 0
            for media in product.media
              if own_done >= own_shown
                break
              endif
              if lead and media.id == lead.id
                continue
              endif
              assign key = ',' | append: media.id | append: ','
              if variant_media contains key
                continue
              endif
              assign own_done = own_done | plus: 1
              assign shown = shown | plus: 1
              assign position = shown | modulo: 3
              assign wide = false
              if position == 1
                assign wide = true
              elsif position == 2 and shown == total
                assign wide = true
              endif
              assign alt = media.alt | default: product.title | escape
              render 'sl-product-media', media: media, wide: wide, alt: alt
            endfor

            assign var_done = 0
            for media in product.media
              if var_done >= var_shown
                break
              endif
              if lead and media.id == lead.id
                continue
              endif
              assign key = ',' | append: media.id | append: ','
              unless variant_media contains key
                continue
              endunless
              assign var_done = var_done | plus: 1
              assign shown = shown | plus: 1
              assign position = shown | modulo: 3
              assign wide = false
              if position == 1
                assign wide = true
              elsif position == 2 and shown == total
                assign wide = true
              endif
              assign alt = media.alt | default: product.title | escape
              render 'sl-product-media', media: media, wide: wide, alt: alt
            endfor
          -%}
        </div>
        {%- if shown > 1 -%}
          <div class="sl-p__dots" data-sl-dots aria-hidden="true">
            {%- for i in (1..shown) -%}<i{% if forloop.first %} class="is-on"{% endif %}></i>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- buy box ---------- {%- endcomment -%}
      <div class="sl-p__buy" id="sl-buy">
        <h1 class="sl-p__title{% if product.title.size > 34 %} sl-p__title--long{% endif %}">{{ product.title | escape }}</h1>
        {%- liquid
          # a "summary" that only repeats the name ("Pegaza Spārni") is left out
          assign sub_plain = f_subtitle | downcase | remove: '"' | remove: '“' | remove: '”' | remove: ' ' | strip
          assign title_plain = product.title | downcase | remove: '"' | remove: '“' | remove: '”' | remove: ' ' | strip
          assign show_subtitle = false
          if f_subtitle != ''
            assign show_subtitle = true
            if title_plain contains sub_plain
              assign show_subtitle = false
            endif
          endif
        -%}
        {%- if show_subtitle -%}
          <p class="sl-p__subtitle">{{ f_subtitle | escape }}</p>
        {%- endif -%}

        {%- assign rating = product.metafields.reviews.rating.value -%}
        {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
        {%- if rating != blank and rating_count > 0 -%}
          <p class="sl-p__rating">
            <span class="sl-p__stars" aria-hidden="true" style="--sl-rating: {{ rating.rating | divided_by: rating.scale_max | times: 100 }}%"></span>
            <span>{{ rating.rating | round: 1 }} · {{ rating_count }} {% if rating_count == 1 %}atsauksme{% else %}atsauksmes{% endif %}</span>
          </p>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="sl-p__app" {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}

        <div class="sl-p__price-row">
          <span class="sl-p__price" data-sl-price>{{ current.price | money }}</span>
          <s class="sl-p__was" data-sl-was{% unless current.compare_at_price > current.price %} hidden{% endunless %}>
            <span class="visually-hidden">Iepriekšējā cena </span>
            <span data-sl-was-amount>{{ current.compare_at_price | money }}</span>
          </s>
          {%- if section.settings.tax_note != blank -%}
            <span class="sl-p__tax">{{ section.settings.tax_note | escape }}</span>
          {%- endif -%}
        </div>

        {%- liquid
          # one small line drawing per kind of fact, drawn in the text colour
          assign svg_open = '<svg class="sl-p__fact-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">'
          capture ico_size
            echo svg_open
            echo '<path d="M3.5 16.5 16.5 3.5l4 4-13 13z"/><path d="M7 13l1.8 1.8M9.5 10.5l1.8 1.8M12 8l1.8 1.8"/></svg>'
          endcapture
          capture ico_metal
            echo svg_open
            echo '<circle cx="12" cy="14" r="6"/><path d="M9.5 3.5h5L16 6l-4 2.5L8 6z"/></svg>'
          endcapture
          capture ico_stone
            echo svg_open
            echo '<path d="M6.5 4h11l3.5 5-9 11L3 9z"/><path d="M3 9h18M9.5 4 12 20 14.5 4"/></svg>'
          endcapture
          capture ico_water
            echo svg_open
            echo '<path d="M12 3.5s6 6.6 6 10.5a6 6 0 0 1-12 0c0-3.9 6-10.5 6-10.5z"/></svg>'
          endcapture
          capture ico_skin
            echo svg_open
            echo '<path d="M12 3.5 19 6v5.5c0 4.2-3 7.6-7 9-4-1.4-7-4.8-7-9V6z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>'
          endcapture
          capture ico_hand
            echo svg_open
            echo '<path d="M8 12.5V6.8a1.4 1.4 0 0 1 2.8 0V11m0-5.6V4.4a1.4 1.4 0 0 1 2.8 0V11m0-5.4a1.4 1.4 0 0 1 2.8 0V12m0-3.6a1.4 1.4 0 0 1 2.8 0v5.2a7 7 0 0 1-7 7h-.6a6.4 6.4 0 0 1-5.3-2.8L5 15.2a1.5 1.5 0 0 1 2.4-1.8L8 14"/></svg>'
          endcapture
        -%}
        {%- capture facts -%}
          {%- if dims != '' -%}<li class="sl-p__fact">{{ ico_size }}<span>{{ dims | escape }}</span></li>{%- endif -%}
          {%- if finish != '' -%}<li class="sl-p__fact">{{ ico_metal }}<span>{{ finish | escape }}</span></li>{%- endif -%}
          {%- liquid
            # plating as a fact of its own, unless the material already says it ("Gold-plated (14 carats)")
            assign show_plating = false
            if f_plating != ''
              unless finish contains '14'
                assign show_plating = true
              endunless
            endif
          -%}
          {%- if show_plating -%}<li class="sl-p__fact">{{ ico_metal }}<span>{{ f_plating | escape }}</span></li>{%- endif -%}
          {%- if f_stone != '' -%}<li class="sl-p__fact">{{ ico_stone }}<span>{{ f_stone | truncate: 40, '…' | escape }}</span></li>{%- endif -%}
          {%- if f_water -%}<li class="sl-p__fact">{{ ico_water }}<span>Nemaina krāsu ūdenī</span></li>{%- elsif f_tarnish -%}<li class="sl-p__fact">{{ ico_water }}<span>Nemaina krāsu</span></li>{%- endif -%}
          {%- if f_hypo -%}<li class="sl-p__fact">{{ ico_skin }}<span>Hipoalerģiska</span></li>{%- endif -%}
          {%- if f_greece -%}<li class="sl-p__fact">{{ ico_hand }}<span>Roku darbs, Grieķija</span></li>{%- endif -%}
        {%- endcapture -%}
        {%- if facts != blank -%}
          <ul class="sl-p__facts" role="list" aria-label="Galvenais">{{ facts }}</ul>
        {%- endif -%}

        {%- form 'product', product, id: form_id, class: 'sl-p__form', novalidate: 'novalidate', data-sl-form: '' -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-sl-variant-id>

          {%- unless product.has_only_default_variant -%}
            <div class="sl-p__options" data-sl-options>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign opt_index = forloop.index0
                  # photo tiles when every value of this option has a photograph of its own; a colour
                  # option without them shows flat colour swatches, anything else shows words
                  assign option_key = option.name | downcase | handleize
                  assign is_color_option = false
                  if option_key contains 'kras' or option_key contains 'color' or option_key contains 'colour' or option_key contains 'metal' or option_key contains 'finish'
                    assign is_color_option = true
                  endif
                  assign visual = true
                  assign seen = ','
                  for value in option.values
                    assign value_media = nil
                    for v in product.variants
                      if v.options[opt_index] == value and v.featured_media
                        assign value_media = v.featured_media
                        break
                      endif
                    endfor
                    if value_media == nil
                      assign visual = false
                      break
                    endif
                    assign key = ',' | append: value_media.id | append: ','
                    if seen contains key
                      assign visual = false
                      break
                    endif
                    assign seen = seen | append: value_media.id | append: ','
                  endfor
                  assign swatches = false
                  if is_color_option and visual == false
                    assign swatches = true
                  endif
                -%}
                <fieldset class="sl-p__option{% if visual %} sl-p__option--tray{% endif %}" data-sl-option="{{ opt_index }}">
                  <legend class="sl-p__legend">{{ option.name | escape }}: <b data-sl-option-value>{{ option.selected_value | escape }}</b></legend>
                  <div class="sl-p__values">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign value_id = sid | append: '-' | append: opt_index | append: '-' | append: forloop.index0
                        assign value_image = nil
                        assign value_available = false
                        for v in product.variants
                          if v.options[opt_index] == value
                            if v.available
                              assign value_available = true
                            endif
                            if value_image == nil and v.featured_media
                              assign value_image = v.featured_media.preview_image
                            endif
                          endif
                        endfor
                      -%}
                      <input
                        class="sl-p__radio visually-hidden"
                        type="radio"
                        id="{{ value_id }}"
                        name="sl-option-{{ section.id }}-{{ opt_index }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      {%- assign swatch_background = '' -%}
                      {%- if swatches -%}
                        {%- liquid
                          assign color_key = value | strip | downcase | replace: ' ', ''
                          # Shopify's own swatch for the value first: its picture over its colour
                          assign swatch_background = value.swatch.color | append: ''
                          if value.swatch.image
                            assign swatch_image = value.swatch.image | image_url: width: 120
                            assign swatch_background = 'url(' | append: swatch_image | append: ') center / cover ' | append: swatch_background
                          endif
                          # otherwise a colour from the value's name
                          if swatch_background == blank
                            case color_key
                              when 'sudraba', 'sudrabs', 'silver'
                                assign swatch_background = '#c8cacc'
                              when 'sudrabs/zelts', 'sudraba/zelta', 'silver/gold', 'gold/silver'
                                assign swatch_background = 'linear-gradient(90deg, #c8cacc 0 50%, #d9aa24 50% 100%)'
                              when 'zelts', 'zelta', 'zeltaina', 'zeltains', 'gold', 'golden'
                                assign swatch_background = '#d9aa24'
                              when 'rožozelts', 'rozaudrab', 'rosegold', 'pinkgold'
                                assign swatch_background = '#b76e79'
                              when 'balta', 'balts', 'white'
                                assign swatch_background = '#ffffff'
                              when 'melna', 'melns', 'black'
                                assign swatch_background = '#171717'
                              when 'rozā', 'roza', 'pink'
                                assign swatch_background = '#d98ca4'
                              when 'sarkana', 'sarkans', 'red'
                                assign swatch_background = '#a3313a'
                              when 'zaļa', 'zala', 'green'
                                assign swatch_background = '#577b55'
                              when 'zila', 'zils', 'blue'
                                assign swatch_background = '#527fa0'
                              when 'violeta', 'violets', 'purple'
                                assign swatch_background = '#71508c'
                              when 'brūna', 'bruna', 'brown'
                                assign swatch_background = '#8a6447'
                              when 'pelēka', 'peleka', 'gray', 'grey'
                                assign swatch_background = '#9a9d9f'
                              when 'oranža', 'oranza', 'orange'
                                assign swatch_background = '#d77a37'
                              when 'caurspīdīga', 'caurspidiga', 'crystal'
                                assign swatch_background = '#f4f3f0'
                            endcase
                          endif
                        -%}
                      {%- endif -%}
                      {%- if visual and value_image -%}
                        <label for="{{ value_id }}" class="sl-p__stone{% unless value_available %} is-out{% endunless %}" title="{{ value | escape }}">
                          {{- value_image | image_url: width: 240 | image_tag: widths: '120, 160, 240', sizes: '80px', loading: 'lazy', alt: '', class: 'sl-p__stone-img' -}}
                          <span class="visually-hidden">{{ value | escape }}{% unless value_available %}, izpārdots{% endunless %}</span>
                        </label>
                      {%- elsif swatches and swatch_background != blank -%}
                        <label for="{{ value_id }}" class="sl-p__stone sl-p__stone--swatch{% unless value_available %} is-out{% endunless %}" style="background: {{ swatch_background }};" title="{{ value | escape }}">
                          <span class="visually-hidden">{{ value | escape }}{% unless value_available %}, izpārdots{% endunless %}</span>
                        </label>
                      {%- else -%}
                        <label for="{{ value_id }}" class="sl-p__chip{% unless value_available %} is-out{% endunless %}">
                          {{- value | escape -}}
                          {%- unless value_available -%}<span class="visually-hidden">, izpārdots</span>{%- endunless -%}
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
            <noscript>
              <label class="sl-p__legend" for="{{ sid }}-select">Variants</label>
              <select id="{{ sid }}-select" name="id" class="sl-p__select">
                {%- for v in product.variants -%}
                  <option value="{{ v.id }}"{% if v == current %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title | escape }} · {{ v.price | money }}</option>
                {%- endfor -%}
              </select>
            </noscript>
          {%- endunless -%}

          {%- liquid
            assign qty = nil
            if current.inventory_management == 'shopify' and current.inventory_policy == 'deny'
              assign qty = current.inventory_quantity
            endif
            assign stock_class = ''
            assign stock_text = section.settings.text_in_stock
            if current.available == false
              assign stock_class = 'is-none'
              assign stock_text = section.settings.text_sold_out
            elsif qty != nil and qty == 1
              assign stock_class = 'is-low'
              assign stock_text = section.settings.text_last
            elsif qty != nil and qty <= section.settings.low_stock
              assign stock_class = 'is-low'
              assign stock_text = section.settings.text_low | replace: '[count]', qty
            endif
          -%}
          <p class="sl-p__stock {{ stock_class }}" data-sl-stock aria-live="polite">{{ stock_text | escape }}</p>

          <button
            type="submit"
            name="add"
            class="sl-p__add"
            data-sl-add
            {% unless current.available %}disabled{% endunless %}
          >
            <span data-sl-add-label>{% if current.available %}Pievienot grozam{% else %}Izpārdots{% endif %}</span>
            <span data-sl-add-price>{% if current.available %}{{ current.price | money }}{% endif %}</span>
          </button>
          <p class="sl-p__error" data-sl-error role="alert" hidden></p>

          {%- if section.settings.show_notify -%}
            {%- assign notify_email = section.settings.notify_email | default: shop.email -%}
            <a
              class="sl-p__notify"
              data-sl-notify
              data-email="{{ notify_email | escape }}"
              data-product="{{ product.title | escape }}"
              href="mailto:{{ notify_email }}?subject={{ product.title | append: ', ' | append: current.title | append: ': paziņot, kad pieejams' | url_encode }}"
              {% if current.available %}hidden{% endif %}
            >Paziņot, kad atkal būs pieejams</a>
          {%- endif -%}
        {%- endform -%}

        <div class="sl-p__added" data-sl-added role="status" hidden>
          <p class="sl-p__added-title" data-sl-added-title>Pievienots grozam</p>
          <a class="sl-p__added-link" href="{{ routes.cart_url }}">Uz grozu</a>
        </div>

        {%- if free_cents > 0 -%}
          {%- liquid
            assign preview_total = cart.total_price | plus: current.price
            assign left = free_cents | minus: preview_total
            assign left_money = left | money
            assign meter = preview_total | times: 100 | divided_by: free_cents
            if meter > 100
              assign meter = 100
            endif
          -%}
          <div class="sl-p__ship" data-sl-ship>
            <p class="sl-p__ship-text" data-sl-ship-text>
              {%- if left > 0 -%}
                {{- section.settings.text_free_left | escape | replace: '[amount]', left_money -}}
              {%- else -%}
                {{- section.settings.text_free_done | escape -}}
              {%- endif -%}
            </p>
            <div class="sl-p__meter" aria-hidden="true"><i data-sl-meter style="width: {{ meter }}%"></i></div>
          </div>
        {%- endif -%}

        {%- capture promises -%}
          {%- for i in (1..3) -%}
            {%- assign key = 'promise_' | append: i -%}
            {%- if section.settings[key] != blank -%}<li>{{ section.settings[key] | escape }}</li>{%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if promises != blank -%}
          <ul class="sl-p__promises" role="list">{{ promises }}</ul>
        {%- endif -%}

        <div class="sl-p__tabs">
          {%- if product.description != blank -%}
            <details class="sl-p__tab"{% if section.settings.open_description %} open{% endif %}>
              <summary>Apraksts</summary>
              <div class="sl-p__tab-body rte">{{ product.description }}</div>
            </details>
          {%- endif -%}

          {%- if has_specs -%}
            <details class="sl-p__tab">
              <summary>Izmēri un materiāli</summary>
              <div class="sl-p__tab-body">
                <dl class="sl-p__spec">
                  {%- if f_length != '' or f_width != '' -%}
                    {%- if f_length != '' -%}<dt>Garums</dt><dd>{{ f_length | escape }}</dd>{%- endif -%}
                    {%- if f_width != '' -%}<dt>Platums</dt><dd>{{ f_width | escape }}</dd>{%- endif -%}
                  {%- elsif f_size != '' -%}
                    <dt>Izmērs</dt><dd>{{ f_size | escape }}</dd>
                  {%- endif -%}
                  {%- if f_diameter != '' -%}<dt>Diametrs</dt><dd>{{ f_diameter | escape }}</dd>{%- endif -%}
                  {%- if f_material != '' -%}<dt>Materiāls</dt><dd>{{ f_material | escape }}</dd>{%- endif -%}
                  {%- if f_plating != '' -%}<dt>Pārklājums</dt><dd>{{ f_plating | escape }}</dd>{%- endif -%}
                  {%- if f_stone != '' -%}<dt>Akmens</dt><dd>{{ f_stone | escape }}</dd>{%- endif -%}
                  {%- if f_color != '' -%}<dt>Krāsa</dt><dd>{{ f_color | escape }}</dd>{%- endif -%}
                  {%- if f_closure != '' -%}<dt>Aizdare</dt><dd>{{ f_closure | escape }}</dd>{%- endif -%}
                  {%- if f_weight != '' -%}<dt>Svars</dt><dd>{{ f_weight | escape }}</dd>{%- endif -%}
                  {%- if f_features != '' -%}<dt>Īpašības</dt><dd>{{ f_features | escape }}</dd>{%- endif -%}
                  {%- if f_water -%}
                    <dt>Ūdens</dt><dd>Nemaina krāsu saskarē ar ūdeni</dd>
                  {%- elsif f_tarnish -%}
                    <dt>Laika gaitā</dt><dd>Nemaina krāsu</dd>
                  {%- endif -%}
                  {%- if f_hypo -%}<dt>Āda</dt><dd>Hipoalerģiska</dd>{%- endif -%}
                  {%- if f_handmade != '' -%}
                    <dt>Roku darbs</dt><dd>{{ f_handmade | escape }}</dd>
                  {%- elsif f_greece -%}
                    <dt>Roku darbs</dt><dd>Darināta ar rokām Grieķijā</dd>
                  {%- endif -%}
                </dl>
              </div>
            </details>
          {%- endif -%}

          {%- liquid
            assign care = ''
            assign mf_care = product.metafields.custom.care
            if mf_care != blank and mf_care.type == 'rich_text_field'
              assign care = mf_care | metafield_tag
            elsif f_care != ''
              assign care = '<p>' | append: f_care | append: '</p>'
            endif
          -%}
          {%- if care != '' or section.settings.care != blank -%}
            <details class="sl-p__tab">
              <summary>Kopšana</summary>
              <div class="sl-p__tab-body rte">
                {%- if care != '' -%}{{ care }}{%- else -%}{{ section.settings.care }}{%- endif -%}
                {%- assign care_product = section.settings.care_product -%}
                {%- if care_product != blank and care_product.id != product.id -%}
                  <p><a href="{{ care_product.url }}">{{ care_product.title | escape }}</a> · {{ care_product.price | money }}</p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}

          {%- if section.settings.shipping != blank -%}
            <details class="sl-p__tab">
              <summary>Piegāde un atgriešana</summary>
              <div class="sl-p__tab-body rte">
                {{ section.settings.shipping }}
                {%- if section.settings.shipping_page != blank -%}
                  <p><a href="{{ section.settings.shipping_page.url }}">Pilni piegādes un atgriešanas noteikumi</a></p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} The phone bar: appears once the main button has scrolled away. {%- endcomment -%}
  <div class="sl-p__bar" data-sl-bar aria-hidden="true">
    {%- assign bar_image = current.featured_media.preview_image | default: product.featured_media.preview_image -%}
    {%- if bar_image -%}
      {{- bar_image | image_url: width: 120 | image_tag: width: 48, height: 48, alt: '', class: 'sl-p__bar-img', loading: 'lazy' -}}
    {%- endif -%}
    <span class="sl-p__bar-text">
      <b data-sl-bar-variant>{% if product.has_only_default_variant %}{{ product.title | escape }}{% else %}{{ current.title | escape }}{% endif %}</b>
      <span data-sl-bar-price>{{ current.price | money }}</span>
    </span>
    <button type="button" class="sl-p__bar-add" data-sl-bar-add tabindex="-1"{% unless current.available %} disabled{% endunless %}>
      {%- if current.available -%}Pievienot grozam{%- else -%}Izpārdots{%- endif -%}
    </button>
  </div>

  {%- comment -%} Everything the script needs to switch variants without asking the server. {%- endcomment -%}
  <script type="application/json" data-sl-product-json>
    {
      "id": {{ product.id }},
      "title": {{ product.title | json }},
      "free": {{ free_cents }},
      "cartTotal": {{ cart.total_price }},
      "lowStock": {{ section.settings.low_stock }},
      "strings": {
        "inStock": {{ section.settings.text_in_stock | json }},
        "low": {{ section.settings.text_low | json }},
        "last": {{ section.settings.text_last | json }},
        "soldOut": {{ section.settings.text_sold_out | json }},
        "freeLeft": {{ section.settings.text_free_left | json }},
        "freeDone": {{ section.settings.text_free_done | json }}
      },
      "variants": [
        {%- for v in product.variants -%}
          {%- liquid
            assign v_qty = 'null'
            if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
              assign v_qty = v.inventory_quantity
            endif
          -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare": {{ v.compare_at_price | default: 0 }},
            "available": {{ v.available }},
            "qty": {{ v_qty }},
            "media": {%- if v.featured_media -%}
              {%- assign vi = v.featured_media.preview_image -%}
              {%- capture srcset -%}{{ vi | image_url: width: 600 }} 600w, {{ vi | image_url: width: 1000 }} 1000w, {{ vi | image_url: width: 1600 }} 1600w{%- endcapture -%}
              {
                "src": {{ vi | image_url: width: 1600 | json }},
                "srcset": {{ srcset | json }},
                "thumb": {{ vi | image_url: width: 120 | json }},
                "alt": {{ v.featured_media.alt | default: product.title | json }}
              }
            {%- else -%}null{%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Sofia Lark product",
  "tag": "div",
  "class": "sl-p-section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Works for every product without setup: size, material and promises (does not change colour, hypoallergenic, handmade) are read from lines such as \"Izmērs: 5 × 5 cm\" or \"Material: Stainless steel\" in the description. Filled product metafields (custom.subtitle, length_mm, width_mm, plating, stone, care) take their place. Add an app block (for example Judge.me stars) to show it under the title."
    },
    {
      "type": "range",
      "id": "max_media",
      "label": "Photographs in the gallery",
      "info": "Variant photographs are shown through the photo tiles. A product with fewer than four photographs of its own fills the gallery with its variant photographs.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "swatch_zoom",
      "label": "Zoom inside the photo tiles",
      "info": "Crops in on the stone when the piece is small in the photograph.",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 150
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Note beside the price",
      "default": "Nodoklis iekļauts"
    },
    {
      "type": "header",
      "content": "Stock"
    },
    {
      "type": "range",
      "id": "low_stock",
      "label": "Say \"only a few left\" from",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "text_in_stock",
      "label": "In stock",
      "default": "Ir noliktavā"
    },
    {
      "type": "text",
      "id": "text_low",
      "label": "A few left",
      "info": "[count] becomes the number.",
      "default": "Palikuši tikai [count]"
    },
    {
      "type": "text",
      "id": "text_last",
      "label": "Last one",
      "default": "Palicis pēdējais"
    },
    {
      "type": "text",
      "id": "text_sold_out",
      "label": "Sold out",
      "default": "Šis variants ir izpārdots"
    },
    {
      "type": "checkbox",
      "id": "show_notify",
      "label": "Offer \"tell me when it is back\" on sold out variants",
      "info": "Opens an e-mail to the shop. A back-in-stock app can replace it later.",
      "default": true
    },
    {
      "type": "text",
      "id": "notify_email",
      "label": "E-mail for those requests",
      "info": "Leave empty to use the shop's e-mail."
    },
    {
      "type": "header",
      "content": "Free delivery"
    },
    {
      "type": "number",
      "id": "free_shipping",
      "label": "Free delivery from (€)",
      "info": "Set 0 to hide the meter.",
      "default": 50
    },
    {
      "type": "text",
      "id": "text_free_left",
      "label": "Still to go",
      "info": "[amount] becomes the sum.",
      "default": "Vēl [amount] līdz bezmaksas piegādei Omniva pakomātā"
    },
    {
      "type": "text",
      "id": "text_free_done",
      "label": "Reached",
      "default": "Piegāde Omniva pakomātā tev būs bez maksas"
    },
    {
      "type": "header",
      "content": "Promises under the button"
    },
    {
      "type": "text",
      "id": "promise_1",
      "label": "First",
      "default": "Saņem bez maksas mūsu veikalā Rīgā"
    },
    {
      "type": "text",
      "id": "promise_2",
      "label": "Second",
      "default": "30 dienas preces atgriešanai"
    },
    {
      "type": "text",
      "id": "promise_3",
      "label": "Third",
      "default": "Katra rota skaistā, dabai draudzīgā iepakojumā"
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "checkbox",
      "id": "open_description",
      "label": "Open the description tab",
      "default": true
    },
    {
      "type": "richtext",
      "id": "care",
      "label": "Care",
      "info": "Used when the product has no custom.care metafield.",
      "default": "<p>Noņem rotu pirms mazgāšanās, peldēšanās, sporta un kosmētikas lietošanas. Glabā sausā vietā, atsevišķi no citām rotām.</p>"
    },
    {
      "type": "product",
      "id": "care_product",
      "label": "Care product to suggest",
      "info": "For example the jewellery care cloth."
    },
    {
      "type": "richtext",
      "id": "shipping",
      "label": "Delivery and returns",
      "default": "<p>Omniva pakomātā visā Latvijā. Bez maksas saņemšana veikalā Blaumaņa ielā 17, Rīgā.</p><p>30 dienas atgriešanai: rotai jābūt nelietotai un oriģinālajā iepakojumā.</p>"
    },
    {
      "type": "page",
      "id": "shipping_page",
      "label": "Page with the full terms"
    }
  ]
}
{% endschema %}
