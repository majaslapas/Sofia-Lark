{%- comment -%}
  Sofia Lark "wear it with": one photograph that stays in place beside a short list of pieces
  that go with this one. Choosing a row opens its line of description, shows its photograph and
  offers to add it to the cart (pieces with more than one variant link to their own page).
  The list is the product's complementary products (Search & Discovery app) or the ones picked
  here, then the care product, so a small order can reach free delivery.
{%- endcomment -%}
{%- liquid
  assign sid = 'SlPair-' | append: section.id
  assign complementary = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
  assign picked = section.settings.products
  assign care = section.settings.care_product
  assign max = section.settings.limit

  assign ids = ',' | append: product.id | append: ','
  assign count = 0
-%}

{%- capture rows -%}
  {%- for item in complementary -%}
    {%- if count >= max -%}{%- break -%}{%- endif -%}
    {%- assign key = ',' | append: item.id | append: ',' -%}
    {%- if ids contains key or item.available == false -%}{%- continue -%}{%- endif -%}
    {%- assign ids = ids | append: item.id | append: ',' -%}
    {%- assign count = count | plus: 1 -%}
    {%- assign row_id = sid | append: '-' | append: count -%}
    {%- render 'sl-pair-row', item: item, row_id: row_id -%}
  {%- endfor -%}
  {%- if count == 0 -%}
    {%- for item in picked -%}
      {%- if count >= max -%}{%- break -%}{%- endif -%}
      {%- assign key = ',' | append: item.id | append: ',' -%}
      {%- if ids contains key or item.available == false -%}{%- continue -%}{%- endif -%}
      {%- assign ids = ids | append: item.id | append: ',' -%}
      {%- assign count = count | plus: 1 -%}
      {%- assign row_id = sid | append: '-' | append: count -%}
      {%- render 'sl-pair-row', item: item, row_id: row_id -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if care != blank and care.available -%}
    {%- assign key = ',' | append: care.id | append: ',' -%}
    {%- unless ids contains key -%}
      {%- assign count = count | plus: 1 -%}
      {%- assign row_id = sid | append: '-care' -%}
      {%- render 'sl-pair-row', item: care, row_id: row_id -%}
    {%- endunless -%}
  {%- endif -%}
{%- endcapture -%}

{%- if count > 0 -%}
  {{ 'sl-product.css' | asset_url | stylesheet_tag }}
  <section class="sl-pair{% if count < 2 %} sl-pair--single{% endif %}" data-sl-pair aria-labelledby="{{ sid }}-title">
    <div class="page-width sl-pair__inner">
      {%- if count > 1 -%}
      <figure class="sl-pair__photo" data-sl-pair-photo data-sl-rise>
        {%- assign photo = section.settings.image -%}
        {%- if photo == blank -%}{%- assign photo = product.media[1].preview_image | default: product.featured_media.preview_image -%}{%- endif -%}
        {%- if photo -%}
          {%- assign photo_alt = photo.alt | default: product.title | escape -%}
          {{- photo | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'lazy', alt: photo_alt, class: 'sl-pair__img' -}}
        {%- endif -%}
      </figure>
      {%- endif -%}
      <div class="sl-pair__list">
        <h2 id="{{ sid }}-title" class="sl-pair__title" data-sl-rise>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="sl-pair__intro" data-sl-rise style="--d: 80ms">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <ul class="sl-pair__rows" role="list">{{ rows }}</ul>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width sl-scale__empty">
    Sofia Lark "wear it with": pick products here, or set complementary products in the Search &amp; Discovery app. Visitors do not see this note.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Sofia Lark wear it with",
  "tag": "div",
  "class": "sl-pair-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's complementary products from the Search & Discovery app. Pick products below for products that have none."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Valkā kopā"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Rotas, kas sader ar šo, un viss, kas vajadzīgs to kopšanai."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 6
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Pieces to show",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "product",
      "id": "care_product",
      "label": "Care product, always last",
      "info": "For example the jewellery care cloth."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "Leave empty to use the product's second photograph. A picture with these pieces together works best."
    }
  ],
  "presets": [
    {
      "name": "Sofia Lark wear it with"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
