{%- comment -%}
  Sofia Lark story page (Laura Lark, Kā top rotas): a long text set as a sequence of chapters.
  Blocks, used in any order:
  - opening: the page's name set large, one line under it and a photograph;
  - split: a photograph beside a heading, words, short points or facts and a large sentence;
  - statement: a sentence set very large, then a "not this / but this" list, then a black band;
  - poem: short lines set large on a sage, stone or black field, beside a photograph;
  - tiles: a few words, each in its own tile (what something is made of, what a wish is for);
  - origin: where a name comes from, set as word + word = name;
  - contact: telephone and e-mail as cards with their buttons;
  - chapter: a number and heading on the left, the words on the right, with optional short lines
    set one under another, a sentence set large, a photograph, and a stone background;
  - steps: up to four numbered items side by side (generations, the stages of making a piece);
  - closing: a black band with a photograph, a large last word, a few lines, a signature and
    links onward.
  Small photographs are never shown wider than they are, so nothing looks soft.
{%- endcomment -%}
{{ 'sl-story.css' | asset_url | stylesheet_tag }}
{%- assign sid = 'SlSt-' | append: section.id -%}

<div class="sl-st">
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {%- case block.type -%}

      {%- when 'opening' -%}
        <header class="sl-st__open page-width{% if b.image == blank %} sl-st__open--plain{% endif %}" {{ block.shopify_attributes }}>
          <div class="sl-st__open-text">
            <nav class="sl-st__crumbs" aria-label="Atrašanās vieta">
              <a href="{{ routes.root_url }}">Sākums</a>
              {%- if b.crumb_label != blank -%}
                <span aria-hidden="true">/</span>
                {%- if b.crumb_link != blank -%}<a href="{{ b.crumb_link }}">{{ b.crumb_label | escape }}</a>{%- else -%}<span>{{ b.crumb_label | escape }}</span>{%- endif -%}
              {%- endif -%}
            </nav>
            <h1 class="sl-st__title">{{ b.title | default: page.title | escape }}</h1>
            {%- if b.lede != blank -%}<p class="sl-st__lede">{{ b.lede | escape }}</p>{%- endif -%}
          </div>
          {%- if b.image != blank -%}
            <figure class="sl-st__open-media" style="--w: {{ b.image.width }}px">
              {%- assign alt = b.image.alt | default: b.title | escape -%}
              {{- b.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 34vw, 100vw', alt: alt, class: 'sl-st__img', fetchpriority: 'high' -}}
            </figure>
          {%- endif -%}
        </header>

      {%- when 'chapter' -%}
        {%- assign ch_id = sid | append: '-' | append: forloop.index -%}
        <section class="sl-st__ch{% if b.tone == 'stone' %} sl-st__ch--stone{% endif %}" aria-labelledby="{{ ch_id }}" {{ block.shopify_attributes }}>
          <div class="page-width sl-st__ch-inner">
            <div class="sl-st__ch-head">
              {%- if b.label != blank -%}<p class="sl-st__num">{{ b.label | escape }}</p>{%- endif -%}
              <h2 id="{{ ch_id }}" class="sl-st__h2">{{ b.heading | escape }}</h2>
            </div>
            <div class="sl-st__ch-body">
              {%- if b.text != blank -%}<div class="sl-st__rte">{{ b.text }}</div>{%- endif -%}
              {%- if b.lines != blank -%}
                <ul class="sl-st__lines" role="list">
                  {%- assign lines = b.lines | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign l = line | strip -%}
                    {%- if l != blank -%}<li>{{ l | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if b.text_after != blank -%}<div class="sl-st__rte">{{ b.text_after }}</div>{%- endif -%}
              {%- if b.quote != blank -%}
                <blockquote class="sl-st__quote">
                  <p>{{ b.quote | escape | newline_to_br }}</p>
                  {%- if b.quote_by != blank -%}<footer>{{ b.quote_by | escape }}</footer>{%- endif -%}
                </blockquote>
              {%- endif -%}
              {%- if b.text_end != blank -%}<div class="sl-st__rte">{{ b.text_end }}</div>{%- endif -%}
              {%- if b.image != blank -%}
                <figure class="sl-st__fig" style="--w: {{ b.image.width }}px">
                  {%- assign alt = b.image.alt | escape -%}
                  {{- b.image | image_url: width: 1400 | image_tag: widths: '400, 600, 900, 1400', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'lazy', alt: alt, class: 'sl-st__img' -}}
                  {%- if b.caption != blank -%}<figcaption>{{ b.caption | escape }}</figcaption>{%- endif -%}
                </figure>
              {%- endif -%}
              {%- if b.link_label != blank and b.link != blank -%}
                <a class="sl-st__link" href="{{ b.link }}">{{ b.link_label | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'steps' -%}
        <section class="sl-st__steps{% if b.tone == 'stone' %} sl-st__ch--stone{% endif %}" {{ block.shopify_attributes }}>
          <div class="page-width">
            {%- if b.heading != blank -%}<h2 class="sl-st__h2 sl-st__steps-title">{{ b.heading | escape }}</h2>{%- endif -%}
            {%- if b.text != blank -%}<div class="sl-st__rte sl-st__steps-text">{{ b.text }}</div>{%- endif -%}
            <ol class="sl-st__grid" role="list">
              {%- for i in (1..4) -%}
                {%- liquid
                  assign k_title = 'item_' | append: i | append: '_title'
                  assign k_text = 'item_' | append: i | append: '_text'
                  assign k_link = 'item_' | append: i | append: '_link'
                  assign t = b[k_title]
                -%}
                {%- if t != blank -%}
                  <li class="sl-st__step">
                    <span class="sl-st__step-num">{{ i | prepend: '0' }}</span>
                    <h3 class="sl-st__h3">
                      {%- if b[k_link] != blank -%}<a href="{{ b[k_link] }}">{{ t | escape }}</a>{%- else -%}{{ t | escape }}{%- endif -%}
                    </h3>
                    <p>{{ b[k_text] | escape }}</p>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
            {%- if b.text_after != blank -%}<div class="sl-st__rte sl-st__steps-text">{{ b.text_after }}</div>{%- endif -%}
          </div>
        </section>

      {%- when 'split' -%}
        {%- assign sp_id = sid | append: '-' | append: forloop.index -%}
        <section class="sl-st__split sl-st--{{ b.tone }}{% if b.image_side == 'right' %} sl-st__split--right{% endif %}{% if b.image == blank %} sl-st__split--plain{% endif %}" aria-labelledby="{{ sp_id }}" {{ block.shopify_attributes }}>
          <div class="page-width sl-st__split-inner">
            {%- if b.image != blank -%}
              <figure class="sl-st__split-media" style="--w: {{ b.image.width }}px">
                {%- assign alt = b.image.alt | escape -%}
                {{- b.image | image_url: width: 1400 | image_tag: widths: '400, 600, 900, 1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', alt: alt, class: 'sl-st__img' -}}
                {%- if b.caption != blank -%}<figcaption>{{ b.caption | escape }}</figcaption>{%- endif -%}
              </figure>
            {%- endif -%}
            <div class="sl-st__split-text">
              {%- if b.label != blank -%}<p class="sl-st__num">{{ b.label | escape }}</p>{%- endif -%}
              <h2 id="{{ sp_id }}" class="sl-st__h2">{{ b.heading | escape }}</h2>
              {%- if b.text != blank -%}<div class="sl-st__rte">{{ b.text }}</div>{%- endif -%}
              {%- if b.lines != blank -%}
                <ul class="sl-st__ticks" role="list">
                  {%- assign lines = b.lines | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign l = line | strip -%}
                    {%- if l != blank -%}<li>{{ l | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if b.fact_1_value != blank or b.fact_2_value != blank -%}
                <dl class="sl-st__facts">
                  {%- for i in (1..3) -%}
                    {%- assign kl = 'fact_' | append: i | append: '_label' -%}
                    {%- assign kv = 'fact_' | append: i | append: '_value' -%}
                    {%- if b[kv] != blank -%}<div><dt>{{ b[kl] | escape }}</dt><dd>{{ b[kv] | escape }}</dd></div>{%- endif -%}
                  {%- endfor -%}
                </dl>
              {%- endif -%}
              {%- if b.text_after != blank -%}<div class="sl-st__rte">{{ b.text_after }}</div>{%- endif -%}
              {%- if b.quote != blank -%}
                <blockquote class="sl-st__quote"><p>{{ b.quote | escape | newline_to_br }}</p></blockquote>
              {%- endif -%}
              {%- if b.link_label != blank and b.link != blank -%}
                <a class="sl-st__link" href="{{ b.link }}"{% if b.link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ b.link_label | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'statement' -%}
        {%- assign stm_id = sid | append: '-' | append: forloop.index -%}
        <section class="sl-st__stm" aria-labelledby="{{ stm_id }}" {{ block.shopify_attributes }}>
          <div class="page-width">
            {%- if b.label != blank -%}<p class="sl-st__num">{{ b.label | escape }}</p>{%- endif -%}
            <h2 id="{{ stm_id }}" class="sl-st__display">{{ b.heading | escape }}</h2>
            <div class="sl-st__stm-grid">
              {%- if b.text != blank -%}<div class="sl-st__rte sl-st__stm-text">{{ b.text }}</div>{%- endif -%}
              <div class="sl-st__contrast">
                {%- if b.contrast_title != blank -%}<p class="sl-st__contrast-title">{{ b.contrast_title | escape }}</p>{%- endif -%}
                <ul class="sl-st__contrast-list{% if b.yes_size == 'text' %} sl-st__contrast-list--text{% endif %}" role="list">
                  {%- assign nos = b.no_lines | newline_to_br | split: '<br />' -%}
                  {%- for line in nos -%}
                    {%- assign l = line | strip -%}
                    {%- if l != blank -%}<li class="is-no">{{ l | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                  {%- assign yeses = b.yes_lines | newline_to_br | split: '<br />' -%}
                  {%- for line in yeses -%}
                    {%- assign l = line | strip -%}
                    {%- if l != blank -%}<li class="is-yes">{{ l | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- if b.text_after != blank -%}<div class="sl-st__rte">{{ b.text_after }}</div>{%- endif -%}
              </div>
            </div>
          </div>
          {%- if b.quote != blank -%}
            <div class="sl-st__band">
              <div class="page-width">
                <blockquote class="sl-st__band-quote"><p>{{ b.quote | escape | newline_to_br }}</p></blockquote>
                {%- if b.link_label != blank and b.link != blank -%}
                  <a class="sl-st__link sl-st__link--light" href="{{ b.link }}">{{ b.link_label | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </section>

      {%- when 'poem' -%}
        {%- assign pm_id = sid | append: '-' | append: forloop.index -%}
        <section class="sl-st__poem sl-st--{{ b.tone }}{% if b.image == blank %} sl-st__poem--plain{% endif %}" aria-labelledby="{{ pm_id }}" {{ block.shopify_attributes }}>
          <div class="page-width sl-st__poem-inner">
            {%- if b.image != blank -%}
              <figure class="sl-st__poem-media">
                {%- assign alt = b.image.alt | escape -%}
                {{- b.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 36vw, 100vw', loading: 'lazy', alt: alt, class: 'sl-st__img' -}}
              </figure>
            {%- endif -%}
            <div class="sl-st__poem-text">
              {%- if b.label != blank -%}<p class="sl-st__num">{{ b.label | escape }}</p>{%- endif -%}
              <h2 id="{{ pm_id }}" class="sl-st__h2">{{ b.heading | escape }}</h2>
              {%- if b.lines != blank -%}
                <p class="sl-st__verse">
                  {%- assign lines = b.lines | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign l = line | strip -%}
                    {%- if l != blank -%}<span>{{ l | escape }}</span>{%- endif -%}
                  {%- endfor -%}
                </p>
              {%- endif -%}
              {%- if b.text != blank -%}<div class="sl-st__rte">{{ b.text }}</div>{%- endif -%}
              {%- if b.quote != blank -%}<p class="sl-st__poem-quote">{{ b.quote | escape | newline_to_br }}</p>{%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'tiles' -%}
        {%- assign tl_id = sid | append: '-' | append: forloop.index -%}
        <section class="sl-st__tiles sl-st--{{ b.tone }}" aria-labelledby="{{ tl_id }}" {{ block.shopify_attributes }}>
          <div class="page-width">
            <div class="sl-st__tiles-head">
              <div>
                {%- if b.label != blank -%}<p class="sl-st__num">{{ b.label | escape }}</p>{%- endif -%}
                <h2 id="{{ tl_id }}" class="sl-st__h2">{{ b.heading | escape }}</h2>
              </div>
              {%- if b.text != blank -%}<div class="sl-st__rte">{{ b.text }}</div>{%- endif -%}
            </div>
            {%- if b.items_title != blank -%}<p class="sl-st__items-title">{{ b.items_title | escape }}</p>{%- endif -%}
            {%- liquid
              # an even grid: up to four in one row, five or six in rows of three, more in rows of four
              assign n = 0
              for i in (1..8)
                assign k_t = 'item_' | append: i | append: '_title'
                if b[k_t] != blank
                  assign n = n | plus: 1
                endif
              endfor
              assign cols = n
              if n == 5 or n == 6
                assign cols = 3
              elsif n > 6
                assign cols = 4
              endif
            -%}
            <ul class="sl-st__tile-grid sl-st__tile-grid--n{{ n }}" role="list" style="--cols: {{ cols }}">
              {%- for i in (1..8) -%}
                {%- liquid
                  assign k_t = 'item_' | append: i | append: '_title'
                  assign k_x = 'item_' | append: i | append: '_text'
                  assign k_l = 'item_' | append: i | append: '_link'
                  assign t = b[k_t]
                -%}
                {%- if t != blank -%}
                  <li class="sl-st__tile">
                    {%- if b[k_l] != blank -%}
                      <a class="sl-st__tile-word" href="{{ b[k_l] }}">{{ t | escape }}</a>
                    {%- else -%}
                      <span class="sl-st__tile-word">{{ t | escape }}</span>
                    {%- endif -%}
                    {%- if b[k_x] != blank -%}<span class="sl-st__tile-text">{{ b[k_x] | escape }}</span>{%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if b.text_after != blank or b.quote != blank -%}
              <div class="sl-st__tiles-foot">
                {%- if b.text_after != blank -%}<div class="sl-st__rte">{{ b.text_after }}</div>{%- endif -%}
                {%- if b.quote != blank -%}<blockquote class="sl-st__quote"><p>{{ b.quote | escape | newline_to_br }}</p></blockquote>{%- endif -%}
                {%- if b.link_label != blank and b.link != blank -%}<a class="sl-st__link" href="{{ b.link }}">{{ b.link_label | escape }}</a>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </section>

      {%- when 'origin' -%}
        {%- assign or_id = sid | append: '-' | append: forloop.index -%}
        <section class="sl-st__origin" aria-labelledby="{{ or_id }}" {{ block.shopify_attributes }}>
          <div class="page-width">
            <div class="sl-st__tiles-head">
              <div>
                {%- if b.label != blank -%}<p class="sl-st__num">{{ b.label | escape }}</p>{%- endif -%}
                <h2 id="{{ or_id }}" class="sl-st__h2">{{ b.heading | escape }}</h2>
              </div>
              {%- if b.text != blank -%}<div class="sl-st__rte">{{ b.text }}</div>{%- endif -%}
            </div>
            <div class="sl-st__sum" role="group" aria-label="{{ b.word_1 | append: ' + ' | append: b.word_2 | append: ' = ' | append: b.word_3 | escape }}">
              <div class="sl-st__term"><span class="sl-st__term-word">{{ b.word_1 | escape }}</span><span class="sl-st__term-cap">{{ b.cap_1 | escape }}</span></div>
              <span class="sl-st__op" aria-hidden="true">+</span>
              <div class="sl-st__term"><span class="sl-st__term-word">{{ b.word_2 | escape }}</span><span class="sl-st__term-cap">{{ b.cap_2 | escape }}</span></div>
              <span class="sl-st__op" aria-hidden="true">=</span>
              <div class="sl-st__term sl-st__term--total"><span class="sl-st__term-word">{{ b.word_3 | escape }}</span><span class="sl-st__term-cap">{{ b.cap_3 | escape }}</span></div>
            </div>
            {%- if b.text_after != blank -%}<div class="sl-st__rte sl-st__origin-after">{{ b.text_after }}</div>{%- endif -%}
          </div>
        </section>

      {%- when 'contact' -%}
        <section class="sl-st__contact sl-st--{{ b.tone }}" {{ block.shopify_attributes }}>
          <div class="page-width">
            {%- if b.heading != blank -%}<h2 class="sl-st__h2 sl-st__contact-title">{{ b.heading | escape }}</h2>{%- endif -%}
            <div class="sl-st__contact-grid">
              {%- if b.phone != blank -%}
                <div class="sl-st__card sl-st__card--main">
                  <p class="sl-st__card-label">{{ b.phone_label | default: 'Tālrunis' | escape }}</p>
                  <a class="sl-st__card-value" href="tel:{{ b.phone | remove: ' ' }}">{{ b.phone | escape }}</a>
                  {%- if b.phone_note != blank -%}<p class="sl-st__card-note">{{ b.phone_note | escape }}</p>{%- endif -%}
                  <a class="sl-st__btn sl-st__btn--solid" href="tel:{{ b.phone | remove: ' ' }}">{{ b.phone_button | default: 'Zvanīt' | escape }}</a>
                </div>
              {%- endif -%}
              {%- if b.email != blank -%}
                <div class="sl-st__card">
                  <p class="sl-st__card-label">{{ b.email_label | default: 'E-pasts' | escape }}</p>
                  <a class="sl-st__card-value" href="mailto:{{ b.email }}">{{ b.email | escape }}</a>
                  {%- if b.email_note != blank -%}<p class="sl-st__card-note">{{ b.email_note | escape }}</p>{%- endif -%}
                  <a class="sl-st__btn" href="mailto:{{ b.email }}">{{ b.email_button | default: 'Rakstīt' | escape }}</a>
                </div>
              {%- endif -%}
              {%- if b.extra_title != blank -%}
                <div class="sl-st__card">
                  <p class="sl-st__card-label">{{ b.extra_label | escape }}</p>
                  <p class="sl-st__card-value">{{ b.extra_title | escape }}</p>
                  {%- if b.extra_note != blank -%}<p class="sl-st__card-note">{{ b.extra_note | escape }}</p>{%- endif -%}
                  {%- if b.extra_link_label != blank and b.extra_link != blank -%}<a class="sl-st__btn" href="{{ b.extra_link }}">{{ b.extra_link_label | escape }}</a>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'closing' -%}
        <section class="sl-st__close{% if b.image != blank %} sl-st__close--image{% endif %}" {{ block.shopify_attributes }}>
          <div class="sl-st__close-inner">
            {%- if b.image != blank -%}
              <figure class="sl-st__close-media">
                {%- assign alt = b.image.alt | escape -%}
                {{- b.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: alt, class: 'sl-st__img' -}}
              </figure>
            {%- endif -%}
            <div class="sl-st__close-text">
              {%- if b.label != blank -%}<p class="sl-st__close-label">{{ b.label | escape }}</p>{%- endif -%}
              <h2 class="sl-st__big">{{ b.heading | escape }}</h2>
              {%- if b.text != blank -%}
                <div class="sl-st__close-body">
                  {%- assign paras = b.text | newline_to_br | split: '<br />' -%}
                  {%- for para in paras -%}
                    {%- assign t = para | strip -%}
                    {%- if t != blank -%}<p>{{ t | escape }}</p>{%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- if b.signature != blank -%}
                <p class="sl-st__sign">{{ b.signature | escape | newline_to_br }}</p>
              {%- endif -%}
              <div class="sl-st__links">
                {%- for i in (1..3) -%}
                  {%- assign k_label = 'link_' | append: i | append: '_label' -%}
                  {%- assign k_url = 'link_' | append: i | append: '_url' -%}
                  {%- if b[k_label] != blank and b[k_url] != blank -%}
                    <a class="sl-st__btn sl-st__btn--light{% if forloop.first %} sl-st__btn--solid{% endif %}" href="{{ b[k_url] }}"{% if b[k_url] contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ b[k_label] | escape }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </section>
    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Sofia Lark story",
  "tag": "div",
  "class": "sl-st-section",
  "blocks": [
    {
      "type": "opening",
      "name": "Opening",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "crumb_label",
          "label": "Breadcrumb",
          "default": "Mūsu stāsts"
        },
        {
          "type": "url",
          "id": "crumb_link",
          "label": "Breadcrumb link"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the page's title."
        },
        {
          "type": "textarea",
          "id": "lede",
          "label": "One line under the title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph"
        }
      ]
    },
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Number",
          "info": "For example 01."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "lines",
          "label": "Short lines",
          "info": "One per line; set one under another."
