{%- comment -%}
  Sofia Lark search-engine and browser details, rendered in the <head> of every page by
  layout/theme.liquid:
  - the favicon and the home-screen icons (the bird, white on black);
  - the meta description, with a written fallback where Shopify has none (categories and
    collections without a description, the collections page);
  - "noindex" on search results and on filtered collection pages, so only the plain pages are
    indexed (the filter links are still followed);
  - structured data for Google: the shop, its website search and the shop in Rīga on the homepage
    and the shop page; each product with its price, availability and Judge.me rating; breadcrumbs
    on products and collections.
  The shop's address, phone and opening hours below match the "Veikals Rīgā" page; change them
  in both places.
{%- endcomment -%}
{%- liquid
  assign brand = 'SOFIA LARK'
  assign store_street = 'Blaumaņa iela 17'
  assign store_city = 'Rīga'
  assign store_country = 'LV'
  assign store_phone = '+371 22066496'
  assign store_days = 'Tuesday,Wednesday,Thursday,Friday' | split: ','
  assign store_opens = '12:00'
  assign store_closes = '19:00'
  assign store_page = '/pages/sofia-lark-veikals'

  assign site = shop.url
  assign shop_name = shop.name | strip
  assign categories = 'all-earrings,necklaces,all-bracletes,gredzeni,piespraudes-1,cleaning-chemicals' | split: ','
-%}

{%- comment -%} a favicon picked in the theme settings takes the place of the bird {%- endcomment -%}
{%- if settings.favicon == blank %}
<link rel="icon" type="image/png" sizes="32x32" href="{{ 'sl-favicon-32.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="48x48" href="{{ 'sl-favicon-48.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="192x192" href="{{ 'sl-icon-192.png' | asset_url }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ 'sl-apple-touch-icon.png' | asset_url }}">
{%- endif %}

{%- liquid
  assign description = page_description | strip_html | strip
  if description == blank
    case request.page_type
      when 'collection'
        assign n = collection.all_products_count
        capture description
          echo collection.title | append: ': '
          if n > 0
            echo n | append: ' '
          endif
          echo brand | append: ' dizaina rotas sievietēm ar raksturu. Veikals Rīgā, Blaumaņa ielā 17, un e-veikals.'
        endcapture
      when 'list-collections'
        capture description
          echo brand | append: ' rotu kolekcijas'
          assign menu = linklists['galvena-izvelne-2026']
          for link in menu.links
            if link.title == 'Kolekcijas'
              assign names = ''
              for item in link.links
                if item.type == 'collection_link'
                  assign names = names | append: item.title | append: '|'
                endif
              endfor
              assign names = names | split: '|' | join: ', '
              if names != blank
                echo ': ' | append: names
              endif
            endif
          endfor
          echo '. Katrai kolekcijai savs stāsts.'
        endcapture
      else
        assign description = shop.description | strip_html | strip
    endcase
  endif
  assign description = description | replace: '  ', ' ' | truncate: 300
-%}
{%- if description != blank %}
<meta name="description" content="{{ description | escape }}">
{%- endif -%}

{%- liquid
  assign noindex = false
  if request.page_type == 'search'
    assign noindex = true
  elsif request.page_type == 'collection'
    for filter in collection.filters
      if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
        assign noindex = true
        break
      endif
    endfor
  endif
-%}
{%- if noindex %}
<meta name="robots" content="noindex, follow">
{%- endif -%}

{%- comment -%} ---------- the shop: homepage and the shop page ---------- {%- endcomment -%}
{%- if request.page_type == 'index' or request.path == store_page -%}
  {%- assign logo = images['sofia-lark-logo-03.png'] -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ site | append: '/#organization' | json }},
        "name": {{ brand | json }},
        "url": {{ site | json }},
        {%- if logo != blank %}
        "logo": {{ logo | image_url: width: 600 | prepend: 'https:' | json }},
        {%- endif %}
        "email": {{ shop.email | json }},
        "telephone": {{ store_phone | json }},
        "sameAs": [
          {%- assign links = '' -%}
          {%- if settings.social_facebook_link != blank -%}{%- assign links = links | append: settings.social_facebook_link | append: '|' -%}{%- endif -%}
          {%- if settings.social_instagram_link != blank -%}{%- assign links = links | append: settings.social_instagram_link | append: '|' -%}{%- endif -%}
          {%- assign links = links | split: '|' -%}
          {%- for l in links -%}{{ l | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
        ]
      },
      {
        "@type": "WebSite",
        "@id": {{ site | append: '/#website' | json }},
        "name": {{ brand | json }},
        "url": {{ site | json }},
        "inLanguage": {{ request.locale.iso_code | json }},
        "publisher": { "@id": {{ site | append: '/#organization' | json }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": {{ site | append: routes.search_url | append: '?q={search_term_string}' | json }}
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "JewelryStore",
        "@id": {{ site | append: store_page | append: '#store' | json }},
        "name": {{ brand | append: ' veikals' | json }},
        "url": {{ site | append: store_page | json }},
        "telephone": {{ store_phone | json }},
        "email": {{ shop.email | json }},
        {%- if logo != blank %}
        "image": {{ logo | image_url: width: 600 | prepend: 'https:' | json }},
        {%- endif %}
        "parentOrganization": { "@id": {{ site | append: '/#organization' | json }} },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ store_street | json }},
          "addressLocality": {{ store_city | json }},
          "addressCountry": {{ store_country | json }}
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": {{ store_days | json }},
            "opens": {{ store_opens | json }},
            "closes": {{ store_closes | json }}
          }
        ]
      }
    ]
  }
  </script>
{%- endif -%}

{%- comment -%} ---------- a product ---------- {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- liquid
    assign crumb = collection
    if crumb == blank
      for c in product.collections
        if categories contains c.handle
          assign crumb = c
          break
        endif
      endfor
    endif
    assign rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
    assign product_description = product.description | strip_html | replace: '  ', ' ' | strip | truncate: 900
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Product",
        "@id": {{ site | append: product.url | append: '#product' | json }},
        "name": {{ product.title | strip | json }},
        "url": {{ site | append: product.url | json }},
        {%- if product_description != blank %}
        "description": {{ product_description | json }},
        {%- endif %}
        {%- if product.media.size > 0 %}
        "image": [
          {%- for media in product.media limit: 6 -%}
            {%- if media.preview_image -%}
              {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
            {%- endif -%}
          {%- endfor -%}
        ],
        {%- endif %}
        {%- if product.selected_or_first_available_variant.sku != blank %}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        {%- endif %}
        "brand": { "@type": "Brand", "name": {{ brand | json }} },
        {%- if product.type != blank %}
        "category": {{ product.type | json }},
        {%- endif %}
        {%- if rating != blank and rating_count > 0 %}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ rating.rating | json }},
          "bestRating": {{ rating.scale_max | json }},
          "worstRating": {{ rating.scale_min | json }},
          "reviewCount": {{ rating_count | json }}
        },
        {%- endif %}
        "offers": [
          {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            {%- if variant.sku != blank %}
            "sku": {{ variant.sku | json }},
            {%- endif %}
            {%- if product.variants.size > 1 %}
            "name": {{ variant.title | json }},
            {%- endif %}
            "url": {{ site | append: variant.url | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "itemCondition": "https://schema.org/NewCondition",
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "seller": { "@type": "Organization", "name": {{ brand | json }} }
          }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Sākums", "item": {{ site | append: routes.root_url | json }} },
          {%- if crumb != blank %}
          { "@type": "ListItem", "position": 2, "name": {{ crumb.title | strip | json }}, "item": {{ site | append: crumb.url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ product.title | strip | json }}, "item": {{ site | append: product.url | json }} }
          {%- else %}
          { "@type": "ListItem", "position": 2, "name": {{ product.title | strip | json }}, "item": {{ site | append: product.url | json }} }
          {%- endif %}
        ]
      }
    ]
  }
  </script>
{%- endif -%}

{%- comment -%} ---------- a collection: where it sits ---------- {%- endcomment -%}
{%- if request.page_type == 'collection' -%}
  {%- liquid
    if collection.template_suffix == 'kolekcija'
      assign parent_name = 'Kolekcijas'
      assign parent_url = routes.collections_url
    elsif collection.handle != 'visas-rotas'
      assign parent_name = 'Rotas'
      assign parent_url = routes.collections_url | append: '/visas-rotas'
    else
      assign parent_name = ''
    endif
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Sākums", "item": {{ site | append: routes.root_url | json }} },
      {%- if parent_name != blank %}
      { "@type": "ListItem", "position": 2, "name": {{ parent_name | json }}, "item": {{ site | append: parent_url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ collection.title | strip | json }}, "item": {{ site | append: collection.url | json }} }
      {%- else %}
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | strip | json }}, "item": {{ site | append: collection.url | json }} }
      {%- endif %}
    ]
  }
  </script>
{%- endif -%}
