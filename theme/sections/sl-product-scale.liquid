{%- comment -%}
  Sofia Lark product, true size: how big the piece really is, for every product.
  With a photograph of it being worn (the product's custom.on_body_image metafield), that
  photograph. Without one, the piece is drawn to scale beside a 1 euro coin (23.25 mm), from the
  size the description gives ("Izmērs: 5 × 5 cm", "Length 61 mm / Width 14 mm"), so the visitor
  can see it rather than imagine it. A product with neither leaves the section out.
{%- endcomment -%}
{%- liquid
  assign sid = 'SlScale-' | append: section.id
  capture facts_raw
    render 'sl-product-facts', product: product
  endcapture
  assign fr = '§' | append: facts_raw
  assign f_size = ''
  assign f_length = ''
  assign f_width = ''
  assign f_diameter = ''
  assign f_story = product.metafields.custom.story.value | default: ''
  assign f_keys = 'size,length,width,diameter' | split: ','
  for k in f_keys
    assign needle = '§' | append: k | append: '¦'
    if fr contains needle
      assign parts = fr | split: needle
      assign val = parts[1] | split: '§' | first | strip
      case k
        when 'size'
          assign f_size = val
        when 'length'
          assign f_length = val
        when 'width'
          assign f_width = val
        when 'diameter'
          assign f_diameter = val
      endcase
    endif
  endfor

  # ---------- numbers in millimetres, from the words ----------
  # "5 X5 cm" → 50, 50 · "4.4cmx4.3cm" → 44, 43 · "61 mm" + "14 mm" → 61, 14 · "16 cm + 3 cm" → too long to draw
  assign src = f_size
  if f_length != ''
    assign src = f_length | append: ' x ' | append: f_width
  endif
  if src == '' and f_diameter != ''
    assign src = f_diameter
  endif
  assign low = src | downcase | replace: ',', '.' | replace: '×', ' ' | replace: 'x', ' ' | replace: 'mm', ' mm ' | replace: 'cm', ' cm '
  assign unit = 0
  if low contains 'mm'
    assign unit = 1
  elsif low contains 'cm'
    assign unit = 10
  endif
  assign n1 = 0
  assign n2 = 0
  assign extra = false
  if low contains '+'
    assign extra = true
  endif
  assign tokens = low | split: ' '
  for t in tokens
    assign n = t | plus: 0
    if n > 0
      if n1 == 0
        assign n1 = n
      elsif n2 == 0
        assign n2 = n
      endif
    endif
  endfor
  assign h = n1 | times: unit
  assign w = n2 | times: unit
  assign is_round = false
  if f_length == '' and f_size == '' and f_diameter != ''
    assign w = h
    assign is_round = true
  endif
  if w == 0 and h > 0 and f_length == '' and f_width == ''
    assign w = h
  endif

  assign drawable = false
  if unit > 0 and h > 0 and w > 0 and extra == false and h <= 120 and w <= 120 and h >= 3 and w >= 3
    assign drawable = true
  endif

  assign image = product.metafields.custom.on_body_image.value
  assign show = false
  if image != blank or drawable
    assign show = true
  endif

  # the drawing, in millimetres: the coin on the left, and on the right a frame of the stated size
  # holding the product's own photograph, measured along its foot and its side; one baseline
  assign coin = 23.25
  assign gap = 12
  assign pad = 4
  assign tallest = h
  if coin > tallest
    assign tallest = coin
  endif
  assign fs = tallest | times: 0.075
  if fs < 3.2
    assign fs = 3.2
  endif
  assign label_w = fs | times: 4.2
  assign label_h = fs | times: 2.2
  assign vb_w = pad | times: 2 | plus: coin | plus: gap | plus: w | plus: label_w
  assign vb_h = pad | times: 2 | plus: tallest | plus: label_h
  assign base_y = pad | plus: tallest
  assign coin_cx = pad | plus: 11.625
  assign coin_cy = base_y | minus: 11.625
  assign piece_x = pad | plus: coin | plus: gap
  assign piece_y = base_y | minus: h
  assign radius = w
  if h < radius
    assign radius = h
  endif
  if is_round
    assign radius = w | divided_by: 2.0
  endif
  assign first_option = product.options_with_values.first
  assign variant_count = 0
  unless product.has_only_default_variant
    assign variant_count = first_option.values.size
  endunless
-%}

{%- if show -%}
  {{ 'sl-product.css' | asset_url | stylesheet_tag }}
  <section class="sl-scale{% if image == blank %} sl-scale--drawn{% endif %}" aria-labelledby="{{ sid }}-title">
    <div class="page-width sl-scale__inner">
      {%- if image != blank -%}
        <figure class="sl-scale__plate" data-sl-rise>
          {%- assign alt = image.alt | default: product.title | escape -%}
          {{- image | image_url: width: 1400 | image_tag: widths: '500, 700, 1000, 1400', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'lazy', alt: alt, class: 'sl-scale__img' -}}
        </figure>
      {%- else -%}
        <figure class="sl-scale__plate sl-scale__plate--drawn" data-sl-rise>
          <svg class="sl-scale__svg" viewBox="0 0 {{ vb_w }} {{ vb_h }}" role="img" aria-labelledby="{{ sid }}-svg">
            <title id="{{ sid }}-svg">{{ product.title | escape }} blakus 1 eiro monētai, mērogā</title>
            <circle class="sl-scale__coin" cx="{{ coin_cx }}" cy="{{ coin_cy }}" r="11.625"></circle>
            <circle class="sl-scale__coin-ring" cx="{{ coin_cx }}" cy="{{ coin_cy }}" r="8.4"></circle>
            <text class="sl-scale__coin-text" x="{{ coin_cx }}" y="{{ coin_cy | plus: 2.4 }}" text-anchor="middle">1 €</text>
            <rect class="sl-scale__box" x="{{ piece_x }}" y="{{ piece_y }}" width="{{ w }}" height="{{ h }}" rx="{% if is_round %}{{ radius }}{% else %}0.8{% endif %}"></rect>
            {%- comment -%} the photograph only fits a frame of about its own square shape {%- endcomment -%}
            {%- assign ratio = w | times: 1.0 | divided_by: h -%}
            {%- if product.featured_media and ratio >= 0.6 and ratio <= 1.6 -%}
              <image class="sl-scale__photo" href="{{ product.featured_media.preview_image | image_url: width: 800 }}" x="{{ piece_x }}" y="{{ piece_y }}" width="{{ w }}" height="{{ h }}" preserveAspectRatio="xMidYMid meet"></image>
            {%- endif -%}
            <text class="sl-scale__dim" x="{{ w | divided_by: 2.0 | plus: piece_x }}" y="{{ base_y | plus: fs | plus: 1.2 }}" font-size="{{ fs }}" text-anchor="middle">{{ w | round: 1 | replace: '.0', '' }} mm</text>
            {%- unless is_round -%}
              <text class="sl-scale__dim" x="{{ piece_x | plus: w | plus: 1.6 }}" y="{{ h | divided_by: 2.0 | plus: piece_y | plus: 1.2 }}" font-size="{{ fs }}">{{ h | round: 1 | replace: '.0', '' }} mm</text>
            {%- endunless -%}
          </svg>
          <figcaption class="sl-scale__caption">
            <span><i class="sl-scale__key sl-scale__key--coin" aria-hidden="true"></i>1 eiro monēta, 23 mm</span>
            <span><i class="sl-scale__key sl-scale__key--piece" aria-hidden="true"></i>{{ product.title | escape }}</span>
          </figcaption>
        </figure>
      {%- endif -%}

      <div class="sl-scale__copy">
        <h2 id="{{ sid }}-title" class="sl-scale__title" data-sl-rise>
          {%- if image != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ section.settings.heading_drawn | escape }}{%- endif -%}
        </h2>
        {%- assign text = f_story -%}
        {%- if text == '' and image == blank -%}{%- assign text = section.settings.text_drawn -%}{%- endif -%}
        {%- if text != blank -%}
          <p class="sl-scale__text" data-sl-rise style="--d: 80ms">{{ text | escape }}</p>
        {%- endif -%}
        <dl class="sl-scale__figures" data-sl-rise style="--d: 160ms">
          {%- if drawable and is_round -%}
            <div><dt>diametrs</dt><dd>{{ h | round: 1 | replace: '.0', '' }} mm</dd></div>
          {%- elsif drawable -%}
            <div><dt>garums</dt><dd>{{ h | round: 1 | replace: '.0', '' }} mm</dd></div>
            <div><dt>platums</dt><dd>{{ w | round: 1 | replace: '.0', '' }} mm</dd></div>
          {%- elsif f_length != '' -%}
            <div><dt>garums</dt><dd>{{ f_length | escape }}</dd></div>
          {%- elsif f_size != '' -%}
            <div><dt>izmērs</dt><dd>{{ f_size | escape }}</dd></div>
          {%- endif -%}
          {%- if variant_count > 1 -%}
            {%- assign opt = first_option.name | downcase -%}
            <div><dt>{% if opt == 'color' or opt == 'colour' or opt == 'krāsa' %}krāsas{% else %}varianti{% endif %}</dt><dd>{{ variant_count }}</dd></div>
          {%- endif -%}
        </dl>
        <div class="sl-scale__actions" data-sl-rise style="--d: 240ms">
          <a class="sl-scale__action sl-scale__action--main" href="#sl-buy">{{ section.settings.choose_label | escape }}</a>
          {%- if section.settings.visit_label != blank and section.settings.visit_link != blank -%}
            <a class="sl-scale__action" href="{{ section.settings.visit_link }}">{{ section.settings.visit_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width sl-scale__empty">
    Sofia Lark true size: this product's description gives no size this section can draw, and it has no custom.on_body_image photograph, so the section is left out here. Visitors do not see this note.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Sofia Lark true size",
  "tag": "div",
  "class": "sl-scale-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Works for every product: with a custom.on_body_image photograph it shows the piece being worn; without one it draws the piece to scale beside a 1 euro coin, from the size in its description. Products with neither leave this section out."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading with a photograph",
      "default": "Tā izskatās valkājot"
    },
    {
      "type": "text",
      "id": "heading_drawn",
      "label": "Heading with the drawing",
      "default": "Īstais izmērs"
    },
    {
      "type": "text",
      "id": "text_drawn",
      "label": "Text with the drawing",
      "info": "A product's custom.story metafield takes its place.",
      "default": "Rota mērogā blakus 1 eiro monētai, lai izmērs nebūtu jāiedomājas."
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Button back to the buy box",
      "default": "Izvēlēties"
    },
    {
      "type": "text",
      "id": "visit_label",
      "label": "Second button",
      "default": "Pielaikot veikalā"
    },
    {
      "type": "url",
      "id": "visit_link",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "Sofia Lark true size"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
