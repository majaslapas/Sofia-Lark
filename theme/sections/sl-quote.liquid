{%- comment -%}
  Sofia Lark reviews: real customer reviews as an even grid of cards, with the store's overall
  rating from Judge.me above them. Copy reviews in as they were written; only real ones.
  The rating line reads Judge.me's shop metafields and is left out when they are missing.
{%- endcomment -%}
{{ 'sl-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign sid = 'SlQuote-' | append: section.id
  assign avg = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating | plus: 0
  assign total = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count | plus: 0
  assign avg_text = avg | round: 1 | append: '' | replace: '.', ','
  assign avg_pct = avg | times: 20
  # Latvian counts: 1, 21, 31 … atsauksme; 11 and the rest atsauksmes
  assign word = 'atsauksmes'
  assign last_digit = total | modulo: 10
  assign last_two = total | modulo: 100
  if last_digit == 1 and last_two != 11
    assign word = 'atsauksme'
  endif
-%}

<section class="sl-quote" aria-labelledby="{{ sid }}-title">
  <div class="page-width">
    <div class="sl-quote__head">
      <div>
        <h2 id="{{ sid }}-title" class="sl-quote__title" data-sl-rise>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="sl-quote__intro" data-sl-rise style="--d: 80ms">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_summary and total > 0 and avg > 0 -%}
        <p class="sl-quote__summary" data-sl-rise style="--d: 120ms">
          <span class="sl-stars" aria-hidden="true" style="--sl-rating: {{ avg_pct }}%"></span>
          <span><b>{{ avg_text }}</b> no 5 · {{ total }} {{ word }}</span>
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a class="sl-quote__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="sl-quote__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="sl-quote__card" data-sl-rise style="--d: {{ forloop.index0 | modulo: 3 | times: 80 }}ms" {{ block.shopify_attributes }}>
            <figure>
              <span class="sl-stars" role="img" aria-label="{{ block.settings.rating }} no 5" style="--sl-rating: {{ block.settings.rating | times: 20 }}%"></span>
              <blockquote>
                <p>{{ block.settings.text | escape }}</p>
              </blockquote>
              <figcaption>
                {{ block.settings.name | escape }}
                {%- if block.settings.about != blank -%}<span>{{ block.settings.about | escape }}</span>{%- endif -%}
              </figcaption>
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sofia Lark reviews",
  "tag": "div",
  "class": "sl-quote-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ko saka klientes"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Atsauksmes par Sofia Lark rotām un veikalu."
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show the overall rating from Judge.me",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Visas atsauksmes"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "about", "label": "About", "info": "What was bought, for example: par auskariem Iliad" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sofia Lark reviews"
    }
  ]
}
{% endschema %}
