{%- comment -%}
  One piece in "Sader kopā": the Sofia Lark product card (the same as everywhere else), then the
  way to buy it in place (pieces with more than one variant link to their own page to choose).
  Accepts: item (a product).
{%- endcomment -%}
<li class="sl-pair__card" data-sl-pair-row>
  <div class="sl-pair__info">
    {%- render 'sl-product-card', product: item, sizes: '(min-width: 990px) 22vw, 46vw' -%}
  </div>
  {%- if item.has_only_default_variant -%}
    {%- form 'product', item, class: 'sl-pair__form' -%}
      <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
      <button type="submit" class="sl-pair__add">Pievienot grozam</button>
    {%- endform -%}
  {%- else -%}
    <a class="sl-pair__add" href="{{ item.url }}">Izvēlēties</a>
  {%- endif -%}
</li>
