{%- comment -%}
  Sofia Lark: the collections page and search results get Latvian titles (Shopify names them
  "Collections" and "Search: … results found").
{%- endcomment -%}
{%- liquid
  assign shop_name = shop.name | strip
  assign title = page_title
  if request.page_type == 'list-collections'
    assign title = 'Kolekcijas'
  elsif request.page_type == 'search'
    if search.performed
      assign title = search.terms | escape | prepend: 'Meklēšana: '
    else
      assign title = 'Meklēšana'
    endif
  endif
-%}
{%- liquid
  assign seo_title = title
  if current_tags
    assign meta_tags = current_tags | join: ', ' | escape
    assign seo_title = seo_title | append: ' – ' | append: meta_tags
  endif
  if current_page != 1
    assign seo_title = seo_title | append: ' – ' | append: current_page | append: '. lapa'
  endif
  if template == 'password'
    assign seo_title = shop_name
  else
    unless title contains shop_name
      assign seo_title = seo_title | append: ' – ' | append: shop_name
    endunless
  endif
-%}
<title>{{ seo_title | strip }}</title>
