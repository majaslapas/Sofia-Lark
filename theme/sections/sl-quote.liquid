{%- comment -%}
  Sofia Lark customer letter: one real review given room to be read, set like a letter, with
  two or three short ones beside it. Copy reviews in as they were written; only real ones.
{%- endcomment -%}
{{ 'sl-product.css' | asset_url | stylesheet_tag }}
{%- assign sid = 'SlQuote-' | append: section.id -%}

<section class="sl-quote" aria-labelledby="{{ sid }}-title">
  <div class="page-width sl-quote__inner">
    <div class="sl-quote__head">
      <h2 id="{{ sid }}-title" class="sl-quote__title" data-sl-rise>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="sl-quote__intro" data-sl-rise style="--d: 80ms">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="sl-quote__link" href="{{ section.settings.link }}" data-sl-rise style="--d: 120ms">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.letter != blank -%}
      <blockquote class="sl-quote__letter" data-sl-rise style="--d: 120ms"{% if section.settings.letter_lang != blank %} lang="{{ section.settings.letter_lang }}"{% endif %}>
        {%- assign paragraphs = section.settings.letter | newline_to_br | split: '<br />' -%}
        {%- for p in paragraphs -%}
          {%- assign line = p | strip -%}
          {%- if line != blank -%}<p>{{ line | escape }}</p>{%- endif -%}
        {%- endfor -%}
        <footer class="sl-quote__sign">
          {{ section.settings.name | escape }}
          {%- if section.settings.role != blank -%}<span>{{ section.settings.role | escape }}</span>{%- endif -%}
        </footer>
      </blockquote>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sl-quote__more">
        {%- for block in section.blocks -%}
          <blockquote class="sl-quote__short" data-sl-rise style="--d: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
            <p>{{ block.settings.text | escape }}</p>
            <cite>{{ block.settings.name | escape }}</cite>
          </blockquote>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sofia Lark review letter",
  "tag": "div",
  "class": "sl-quote-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ko saka klientes"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Atsauksmes par Sofia Lark rotām un veikalu."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Visas atsauksmes"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "The letter"
    },
    {
      "type": "textarea",
      "id": "letter",
      "label": "Review",
      "info": "The first line is set large. Start a new line for each paragraph."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Below the name",
      "default": "Sofia Lark kliente"
    },
    {
      "type": "select",
      "id": "letter_lang",
      "label": "Language of the review",
      "options": [
        { "value": "", "label": "Latvian" },
        { "value": "en", "label": "English" },
        { "value": "ru", "label": "Russian" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Short review",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sofia Lark review letter"
    }
  ]
}
{% endschema %}
