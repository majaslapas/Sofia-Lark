{%- comment -%}
  Sofia Lark "goes with": one photograph that stays in place beside a short list of pieces that
  go with this one. Choosing a row opens its line of description, shows its photograph and
  offers to add it to the cart (pieces with more than one variant link to their own page).

  Works for every product without setup. The list is, in order: the product's complementary
  products (Search & Discovery app), or the ones picked here, or else Shopify's own product
  recommendations for it, fetched after the page loads; the care product always comes last, so a
  small order can reach free delivery. When Shopify renders this section for its recommendations
  endpoint, `recommendations` is filled and the rows come from it.
{%- endcomment -%}
{%- liquid
  assign sid = 'SlPair-' | append: section.id
  assign care = section.settings.care_product
  assign max = section.settings.limit

  assign list = nil
  assign mode = 'own'
  if recommendations.performed?
    assign list = recommendations.products
    assign mode = 'recommended'
  else
    assign list = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
    if list == blank or list.size == 0
      assign list = section.settings.products
    endif
    if list == blank or list.size == 0
      assign list = nil
      assign mode = 'fetch'
    endif
  endif

  assign ids = ','
  if product
    assign ids = ids | append: product.id | append: ','
  endif
  if care != blank
    assign ids = ids | append: care.id | append: ','
  endif
  assign count = 0
-%}

{%- capture rows -%}
  {%- for item in list -%}
    {%- if count >= max -%}{%- break -%}{%- endif -%}
    {%- assign key = ',' | append: item.id | append: ',' -%}
    {%- if ids contains key or item.available == false -%}{%- continue -%}{%- endif -%}
    {%- assign ids = ids | append: item.id | append: ',' -%}
    {%- assign count = count | plus: 1 -%}
    {%- assign row_id = sid | append: '-' | append: count -%}
    {%- render 'sl-pair-row', item: item, row_id: row_id -%}
  {%- endfor -%}
  {%- if care != blank and care.available and care.id != product.id -%}
    {%- assign count = count | plus: 1 -%}
    {%- assign row_id = sid | append: '-care' -%}
    {%- render 'sl-pair-row', item: care, row_id: row_id -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  # the photograph: the one picked here, or the first piece on the list
  assign photo = section.settings.image
  if photo == blank
    for item in list
      if item.featured_media
        assign photo = item.featured_media.preview_image
        break
      endif
    endfor
  endif
  if photo == blank and care != blank
    assign photo = care.featured_media.preview_image
  endif
  assign url = ''
  if mode == 'fetch' and product
    assign url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: max | append: '&intent=related'
  endif
-%}

{{ 'sl-product.css' | asset_url | stylesheet_tag }}
<section
  class="sl-pair{% if count < 2 %} sl-pair--single{% endif %}"
  data-sl-pair
  {% if url != '' %}data-sl-recommend="{{ url }}"{% endif %}
  {% if count == 0 %}hidden{% endif %}
  aria-labelledby="{{ sid }}-title"
>
  <div class="page-width sl-pair__inner">
    {%- if count > 1 and photo -%}
      <figure class="sl-pair__photo" data-sl-pair-photo data-sl-rise>
        {%- assign photo_alt = photo.alt | default: section.settings.heading | escape -%}
        {{- photo | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'lazy', alt: photo_alt, class: 'sl-pair__img' -}}
      </figure>
    {%- endif -%}
    <div class="sl-pair__list">
      <h2 id="{{ sid }}-title" class="sl-pair__title" data-sl-rise>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="sl-pair__intro" data-sl-rise style="--d: 80ms">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <ul class="sl-pair__rows" role="list">{{ rows }}</ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sofia Lark goes with",
  "tag": "div",
  "class": "sl-pair-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Works for every product: shows its complementary products from the Search & Discovery app when it has them, else the products picked below, else Shopify's own recommendations for it. The care product always comes last."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sader kopā"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Rotas, kas labi izskatās kopā ar šo, un viss, kas vajadzīgs to kopšanai."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "Only for products with no complementary products of their own. Leave empty to let Shopify recommend.",
      "limit": 6
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Pieces to show",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "product",
      "id": "care_product",
      "label": "Care product, always last",
      "info": "For example the jewellery care cloth."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "Leave empty to use the first piece's photograph."
    }
  ],
  "presets": [
    {
      "name": "Sofia Lark goes with"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
